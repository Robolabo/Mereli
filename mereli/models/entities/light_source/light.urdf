<?xml version="1.0" ?>
<robot name="light">
  <link name="baseLink">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
       <mass value="0.0"/>
       <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0."/>
      <geometry>
				<mesh filename="sphere.obj" scale="0.3 0.3 0.3"/>      
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
    </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0."/>
      <geometry>
	      <mesh filename="sphere.obj" scale="0.3 0.3 0.3"/> 
      </geometry>
    </collision>
  </link>
  <lightsource link='baseLink' luminosity='1' color='red'/>



</robot>
