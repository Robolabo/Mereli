{
    "checkpoint_file" : "chk_intelligent_prey_SNES",
    "num_processes" : 1,
    "render" : false,
    "topology" : {
        "dt" : 0.1,
        "time_scale" : 20,
        "stimuli": {
            "W1" : {"n" : 2, "sensor" : "wireless_receiver:msg"},
            "W2" : {"n" : 2, "sensor" : "wireless_receiver:receiving_direction"},
            "W4" : {"n" : 1, "sensor" : "wireless_receiver:signal"},
            "W5" : {"n" : 1, "sensor" : "wireless_receiver:am_i_targeted"},
            "W6" : {"n" : 6, "sensor" : "light_sensor"}
        },
        "encoding" : {
            "W1" :{"scheme" : "IdentityEncoding", "receptive_field" : {}},
            "W2" :{"scheme" : "IdentityEncoding", "receptive_field" : {}},
            "W4" :{"scheme" : "IdentityEncoding", "receptive_field" : {}},
            "W5" :{"scheme" : "IdentityEncoding", "receptive_field" : {}},
            "W6" :{"scheme" : "IdentityEncoding", "receptive_field" : {}}
        },
        "neurons" : {"model": "ctrnn", "params": {"tau":0.35, "gain" : 1.0, "bias" : -1.0}},
        "ensembles": {
            "C" : {"n" : 25, "tau" : 10, "gain" : 1, "bias": 0, "activation":"tanh"},

            "OUT_COMM" : {"n" : 2, "tau" : 8, "gain" : 2, "bias": 0, "activation":"sigmoid"},
            "OUT_COMM_PR" : {"n" : 1, "tau" : 8, "gain" : 2, "bias": 0, "activation":"sigmoid"},
            "OUT" : {"n" : 2, "tau" : 10, "gain" : 2, "bias": 0, "activation":"sigmoid"}
        },
        "outputs" : {
            "outC" : {"ensemble" : ["OUT_COMM_PR"], "actuator" : "IR_transmitter:priority", "enc": "real"},
            "outA" : {"ensemble" : ["OUT_COMM"], "actuator" : "IR_transmitter", "enc": "real"},
            "outB" : {"ensemble" : ["OUT"], "actuator" : "wheel_actuator", "enc": "real"}
        },
        "synapses" :  {
            "W1-fast" : {"pre":"W1","post":"C", "trainable":true, "p":0.5},
            "W2-fast" : {"pre":"W2","post":"C", "trainable":true, "p":0.5},
            "W4-fast" : {"pre":"W4","post":"C", "trainable":true, "p":0.5},
            "W5-fast" : {"pre":"W5","post":"C", "trainable":true, "p":0.5},
            "W6-fast" : {"pre":"W6","post":"C", "trainable":true, "p":0.3},
            

            "c-c" : {"pre":"C","post":"C", "trainable":true, "p":0.3},

            "fast-comm" : {"pre":"C","post":"OUT_COMM", "trainable":true, "p":0.3},
            "fast-pri" : {"pre":"C","post":"OUT_COMM_PR", "trainable":true, "p":0.3},
            "fast-mot" : {"pre":"C","post":"OUT", "trainable":true, "p":0.3},
            "comm-fast" : {"pre":"OUT_COMM","post":"C", "trainable":true, "p":0.3},
            "pri-fast" : {"pre":"OUT_COMM_PR","post":"C", "trainable":true, "p":0.3},
            "mot-fast" : {"pre":"OUT","post":"C", "trainable":true, "p":0.3},
            
            "comm-comm" : {"pre":"OUT_COMM","post":"OUT_COMM", "trainable":true, "p":1},
            "comm-pri" : {"pre":"OUT_COMM","post":"OUT_COMM_PR", "trainable":true, "p":1},
            "mot-mot" : {"pre":"OUT","post":"OUT", "trainable":true, "p":1}
        },
        "decoding" : {
            "outC" : {"scheme" : "ThresholdDecoding", "params" : {"is_cat" : true}},
            "outA" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}},
            "outB" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}}
        } 
    },
    "algorithm" : {
        "name" : "SNES",
        "evolvable_object" : "robotA",
        "population_size" : 50,
        "generations" : 5000,
        "evaluation_steps" : 800,
        "num_evaluations" : 1,
        "fitness_function" : "goto_light",
        "populations" : {
            "p1" : {
                "objects" : ["synapses:weights:sensory", "synapses:weights:hidden", "synapses:weights:motor", "neurons:bias:all",  "neurons:tau:all"],
                "max_vals" : [2, 2, 2, 1, 1],
                "min_vals" : [-2, -2,-2, -1, -1],
                "encoding" : "real",
                "selection_operator" : "nonlin_rank",
                "crossover_operator" : "blxalpha",
                "mutation_operator" : "gaussian",
                "mating_operator" : "random",
                "mutation_prob" : 0.05,
                "crossover_prob" : 0.9,
                "num_elite" : 2
            }
        }
    }, 
    "world":{
        "world_delay" : 1,
        "render_connections":false,
        "height":1000,
        "width": 1000,
        "objects" : {
            "robotA" : {
                "type" : "robot",
                "num_instances" : 8,
                "controller" : "neural_controller",
                "sensors" : {"wireless_receiver" : {"n_sectors":4, "range" : 1200,  "msg_length" : 2}, "light_sensor" : {"rho_decay":2000, "range": 2000, "n_sectors" : 6}},
                "actuators" : {"wheel_actuator" : {}, "IR_transmitter" : {"range" : 1200, "msg_length" : 2}},
                "positions" : "random",
                "initializers" : {
                    "positions" : {"name" : "random_uniform", "params" : {"low":500, "high" : 600, "size":2}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low":0, "high" : 3.1415, "size" : 1}}
                },
                "all_positions" : [
                    [[460, 500], [500, 500], [547, 500], [460, 550], [500, 550],[547, 550], [460, 456], [500, 456],[547, 456]]
                ],
                "params" : {"trainable" : true}
            },
            "light_red" : {
                "type" : "light_source",
                "num_instances": 1,
                "controller" : "prey_controller",
                "positions" : "random",
                "initializers" : {
                    "positions" : {"name" : "random_circumference", "params" : {"radius": 1, "center" : [470, 470]}}
                },
                "params" : {"range" : 2000, "color" : "grey"}
            }
        }
    }
}
