{
    "checkpoint_file" : "chk_obstacle_avoidanceGA",
    "topology" : {
        "main_ann" : {
            "dt" : 0.1,
            "time_scale" : 1,
            "stimuli": {
                "I1" : {"n" : 8, "sensor" : "distance_sensor"}
            },
            "neuron_model" : "rate_model",
            "synapse_model" : "static_synapse",
            "ensembles": {
                "OUT" : {"n" : 2, "params" : {"activation" : "tanh"}}
            },
            "outputs" : {
                "outA" : {"ensemble" : "OUT", "actuator" : "joint_velocity_actuator"}
            },
            "synapses" :  {
                "i-O" : {"pre":"I1","post":"OUT", "trainable":true, "p":1.0}
            },
            "decoding" : {
                "outA" : {"scheme" : "IdentityDecoding"}
            },
            "learning_rule" : {}
        } 
    },
    "world": {
        "name" : "square_arena",
        "arena_params" : {"height" : 3, "width" : 3},
        "engine" : "pybullet",
        "physics_dt" : 0.05,
        "T_control" : 0.05,
        "task_manager" : {
            "total_duration" : 1000,
            "num_slots" : 1,
            "use_done" : false,
            "tasks" : [{"name" : "obstacle_avoidance", "params" : {}}]
        },
        "objects" : {
            "robotA" : {
                "type" : "epuck",
                "num_instances" : 5,
                "controller" : {
                    "name" : "neural_controller",
                    "topology" : "main_ann",
                    "params" : {}},
                "sensors" : {
                    "distance_sensor" : {"range" : 1}
                },
                "actuators" : {
                    "joint_velocity_actuator" : {"joint_ids" : [0, 1], "max_velocity" : 10}
                },
                "initializers" : {
                    "positions" : {"name" : "random_uniform",  "params" : {"low": [-1,-1],"high" : [1,1], "size" : 2}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low": 0,"high" : 6.28, "size" : 1}}
                },
                "perturbations" : {},
                "params" : {"trainable" : true}
            }
        }
    },
    "algorithm" : {
        "name" : "NEAT",
        "population_size" : 50,
        "generations" : 1000,
        "evaluation_steps" : 3000,
        "num_evaluations" : 1,
        "fitness_function" : "reward_integration",
        "targets" : [{"topology" : "main_ann", "object" :"robotA:controller@neural_network"}],
        "gene_info" : {
            "main_ann:connections:weight:all" : {
                "normalization" : {"type": "linear", "min_val" : -5, "max_val" : 5}, 
                "initialization" : {"type" : "gaussian", "sigma" : 1},
                "mutation" : {"type" : "gaussian", "mutation_prob": 0.1, "sigma" : 0.1}},
            "main_ann:nodes:bias:all" : {
                "normalization" : {"type": "linear", "min_val" : -2, "max_val" : 2}, 
                "initialization" : {"type" : "gaussian", "sigma" : 1},
                "mutation" : {"type" : "gaussian", "mutation_prob": 0.1, "sigma" : 0.05}}
        },
        "alg_params" : {
            "p_weight_mut" : 0.4, "p_node_mut" : 0.05, "p_conn_mut" : 0.1, "compatib_thresh" : 1.4,
            "c1" : 1, "c2" : 1, "c3" : 1, "species_elites" : 2
        }
    }
}
