{
    "checkpoint_file" : "chk_group_formation",
    "logging" : {"file" : "group_formation"},
    "topology" : {
        "main_ann" : {
            "dt" : 0.1,
            "time_scale" : 1,
            "stimuli": {
                "I1" : {"n" : 2, "sensor" : "mean_neigh_state"},
                "I2" : {"n" : 2, "sensor" : "own_state"},
                "I3" : {"n" : 2, "sensor" : "closest_state"}
            },
            "neuron_model" : "rate_model",
            "synapse_model" : "static_synapse",
            "ensembles": {
                "OUT_COMM" : {"n" : 2, "params" : {"activation" : "tanh", "gain" : 4, "tau" : 1}}
            },
            "outputs" : {
                "outB" : {"ensemble" : "OUT_COMM", "actuator" : "stateful_tx", "enc": "real"}
            },
            "synapses" :  {
                "I1-C" : {"pre":"I1","post":"OUT_COMM", "trainable":true, "p":1.0},
                "I2-C" : {"pre":"I2","post":"OUT_COMM", "trainable":true, "p":1.0},
                "I3-C" : {"pre":"I3","post":"OUT_COMM", "trainable":true, "p":1.0}
            },
            "decoding" : {
                "outB" : {"scheme" : "IdentityDecoding"}
            },
            "learning_rule" : {}
        } 
    },
    "world": {
        "name" : "flat_world",
        "engine" : "pybullet",
        "physics_dt" : 0.05,
        "T_control" : 0.05,
        "task_manager" : {
            "total_duration" : 500,
            "num_slots" : 1,
            "use_done" : false,
            "tasks" : [{"name" : "group_formation", "params" : {
		    "radius" : 0.2,
		    "num_members" : 2,
		    "centroids" : [[0.75, -0.75], [0.75, 0.75], [-0.75, -0.75], [-0.75, 0.75]] 
	    }}]
        },
        "objects" : {
            "robotA" : {
                "type" : "epuck",
                "num_instances" : 8,
                "controller" : {
                    "name" : "neural_controller",
                    "topology" : "main_ann",
                    "params" : {}},
                "sensors" : {
                    "stateful_rx" : {"state_dim" : 2, "range" : 12}
                },
                "actuators" : {
                    "stateful_tx" : {"state_dim" : 2, "range" : 12},
                    "led_actuator" : {}
                },
                "initializers" : {
                    "positions" : {"name" : "random_graph",  "params" : {"max_rad": 1.1,"initial_pos" : [0,0]}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low": 0,"high" : 6.28, "size" : 1}}
                },
               "perturbations" : {},
                "params" : {"trainable" : true}
	    }
        }
    },
    "algorithm" : {
        "name" : "NEAT",
        "population_size" : 200,
        "generations" : 200,
        "evaluation_steps" : 3000,
        "num_evaluations" : 4,
        "fitness_function" : "reward_integration",
	"targets" : [{"topology" : "main_ann", "object" :"robotA:controller@neural_network"}],
	"gene_info" : {
	    "main_ann:connections:weight:all" : {
		"normalization" : {"type": "linear", "min_val" : -5, "max_val" : 5}, 
		"initialization" : {"type" : "gaussian", "sigma" : 1},
		"mutation" : {"type" : "gaussian", "mutation_prob": 0.3, "sigma" : 0.1}},
	    "main_ann:nodes:bias:all" : {
		"normalization" : {"type": "linear", "min_val" : -5, "max_val" : 5},
		"initialization" : {"type" : "gaussian", "sigma" : 1},
		"mutation" : {"type" : "gaussian", "mutation_prob": 0.3, "sigma" : 0.1}}
	},
	"alg_params" : {
	    "p_weight_mut" : 0.4, "p_node_mut" : 0.05, "p_conn_mut" : 0.2, "compatib_thresh" : 4,
	    "c1" : 0.5, "c2" : 0.5, "c3" : 2, "species_elites" : 2
	}
    }
}
