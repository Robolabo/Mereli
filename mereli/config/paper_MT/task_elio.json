{
    "checkpoint_file" : "chk_task_elio",
    "logging" : {"file" : "task_elio"},
    "topology" : {
        "main_ann" : {
            "dt" : 0.1,
            "time_scale" : 1,
            "stimuli": {
                "I1" : {"n" : 1, "sensor" : "dist_closest_tar"},
                "I2" : {"n" : 1, "sensor" : "phi_closest_tar"},
                "I3" : {"n" : 1, "sensor" : "dist_closest_st"},
                "I4" : {"n" : 1, "sensor" : "phi_closest_st"},
                "I5" : {"n" : 2, "sensor" : "sensor_readings"}
            },
            "neuron_model" : "rate_model",
            "synapse_model" : "static_synapse",
            "ensembles": {
                "OUT_COMM" : {"n" : 2, "params" : {"activation" : "tanh", "gain" : 4, "tau" : 1}}
            },
            "outputs" : {
                "outA" : {"ensemble" : "OUT_COMM", "actuator" : "ori_stateful_tx", "enc": "real"}
            },
            "synapses" :  {
                "I1-ORI" : {"pre":"I1","post":"OUT_COMM", "trainable":true, "p":1.0},
                "I2-ORI" : {"pre":"I2","post":"OUT_COMM", "trainable":true, "p":1.0},
                "I3-ORI" : {"pre":"I3","post":"OUT_COMM", "trainable":true, "p":1.0},
                "I4-ORI" : {"pre":"I4","post":"OUT_COMM", "trainable":true, "p":1.0},
                "I5-ORI" : {"pre":"I5","post":"OUT_COMM", "trainable":true, "p":1.0}
            },
            "decoding" : {
                "outA" : {"scheme" : "IdentityDecoding"}
            },
            "learning_rule" : {}
        } 
    },
    "world": {
        "name" : "flat_world",
        "engine" : "pybullet",
        "physics_dt" : 0.05,
        "T_control" : 0.05,
        "task_manager" : {
            "total_duration" : 1000,
            "num_slots" : 1,
            "use_done" : false,
            "tasks" : [{"name" : "elio_task", "params" : {"n_points" : 4, "points" : [[0.7, 0.7], [0.7, -0.7], [-0.7, 0.7], [-0.7,-0.7]]}}]
        },
        "objects" : {
            "robotA" : {
                "type" : "epuck",
                "num_instances" : 2,
                "controller" : {
                    "name" : "neural_controller",
                    "topology" : "main_ann",
                    "params" : {}},
                "sensors" : {
                    "ori_stateful_rx" : {"state_dim" : 2, "range" : 2, "use_estimation" : true},
                    "ground_sensor" : {}
                },
                "actuators" : {
                    "ori_stateful_tx" : {"state_dim" : 2, "tau_st" : 10, "tau_ori" : 10, "init_state" : "random", "init_ori" : "random",  "range" : 2},
                    "led_actuator" : {}
                },
                "initializers" : {
                    "positions" :  {"name" : "fixed",  "params" : {"fixed_values": [[0,0] , [1, 1]]}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low": 0,"high" : 6.28, "size" : 1}}
                },
                "perturbations" : {},
                "params" : {"trainable" : true}
	    }, 
	    "ground_area_1" : {
	    	"type" : "ground_area",
		"num_instances" : 2,
		"params" : {"radius" : 0.6},
	        "initializers" : {"positions" : {"name" : "fixed",  "params" : {"fixed_values": [[0,0] , [1, 1]]}}}	
	    }
        }
    },
    "algorithm" : {
        "name" : "NEAT",
        "population_size" : 50,
        "generations" : 200,
        "evaluation_steps" : 3000,
        "num_evaluations" : 1,
        "fitness_function" : "reward_integration",
	"targets" : [{"topology" : "main_ann", "object" :"robotA:controller@neural_network"}],
	"gene_info" : {
	    "main_ann:connections:weight:all" : {
		"normalization" : {"type": "linear", "min_val" : -5, "max_val" : 5}, 
		"initialization" : {"type" : "gaussian", "sigma" : 1},
		"mutation" : {"type" : "gaussian", "mutation_prob": 0.1, "sigma" : 0.05}},
	    "main_ann:nodes:bias:all" : {
		"normalization" : {"type": "linear", "min_val" : -5, "max_val" : 5},
		"initialization" : {"type" : "gaussian", "sigma" : 1},
		"mutation" : {"type" : "gaussian", "mutation_prob": 0.1, "sigma" : 0.05}}
	},
	"alg_params" : {
	    "p_weight_mut" : 0.5, "p_node_mut" : 0.05, "p_conn_mut" : 0.2, "compatib_thresh" : 3.2,
	    "c1" : 0.5, "c2" : 0.5, "c3" : 2, "species_elites" : 2
	}
    }
}
