{
    "checkpoint_file" : "chk_generaliz_v5",
    "logging" : {
	"file" : "formation_circ_8",
	"data": [
	"robotA@position","robotA@orientation", "robotA:virtual_particle@state",
       	"robotA:virtual_particle@orientation", "virtual_space@landmarks", 
	"robotA:virtual_particle@lmark", "robotA:controller:routines:basic_goto_coords@target_coords" 
	]
    },
    "simulation" : {
	 "timesteps" : 10000,
	 "trials" : 1,
	 "start_paused" : false,
	 "animated_layout" : {
		"enabled" : false, 
		"grid" : "A;.",
	 	"plots" : [
			{"plot_type" : "comm_space",  "name" : "A", "H" : 8, "W" : 8 }
		]  
	 }
    },
    "topology" : {
        "comm_ann" : {
            "dt" : 0.1,
            "time_scale" : 1,
            "stimuli": {
                "I1" : {"n" : 1, "sensor" : "dist_clst_st"},
                "I2" : {"n" : 1, "sensor" : "phi_clst_st"},
                "I3" : {"n" : 1, "sensor" : "dist_clst_lmark"},
                "I4" : {"n" : 1, "sensor" : "phi_clst_lmark"},
                "I5" : {"n" : 1, "sensor" : "dist_clst_lmark_av"},
                "I6" : {"n" : 1, "sensor" : "phi_clst_lmark_av"}
  		},
            "neuron_model" : "rate_model",
            "synapse_model" : "static_synapse",
            "ensembles": {
                "CONTROL" : {"n" : 2, "params" : {"activation" : "tanh", "gain" : 4, "tau" : 1}}
            },
            "outputs" : {
                "out" : {"ensemble" : "CONTROL", "actuator" : "control", "enc": "real"}
            },
            "synapses" :  {
                "I1-CONTROL" : {"pre":"I1","post":"CONTROL", "trainable":true, "p":1.0},
                "I2-CONTROL" : {"pre":"I2","post":"CONTROL", "trainable":true, "p":1.0},
                "I3-CONTROL" : {"pre":"I3","post":"CONTROL", "trainable":true, "p":1.0},
                "I4-CONTROL" : {"pre":"I4","post":"CONTROL", "trainable":true, "p":1.0},
                "I5-CONTROL" : {"pre":"I5","post":"CONTROL", "trainable":true, "p":1.0},
                "I6-CONTROL" : {"pre":"I6","post":"CONTROL", "trainable":true, "p":1.0}
            },
            "decoding" : {
                "out" : {"scheme" : "IdentityDecoding"}
            },
            "learning_rule" : {}
        } 
    },
    "world": {
        "name" : "flat_world",
        "arena_params" : {
        },
        "engine" : "pybullet",
        "physics_dt" : 0.05,
        "T_control" : 0.05,
        "task_manager" : {
            "total_duration" : 10000,
            "num_slots" : 1,
            "use_done" : false,
            "tasks" : [{"name" : "comm_formation", "params" : {"threshold" : 2}}]
        },
        "objects" : {
            "robotA" : {
                "type" : "epuck",
                "num_instances" : 8,
		"positions" : {"type" : "random", "low" : [-1,-1], "high" : [1,1]}, 
		"orientations" : "random",
                "controller" : {
                    "name" : "subsumption",
                    "params" : {"routines" : {"basic_obstacle_avoider" : {"priority" : 0, "params" : {"sensitivity" : 0.8}}, 
			    		 	"basic_goto_coords" : {"priority" : 1, "params" : {"formation" : "formation_circle_24"}}}}},
                "sensors" : {
                    "distance_sensor" : {"n_sectors" : 8},
                    "ground_sensor" : {},
                    "own_position_sensor" : {}
                },
                "actuators" : {
                    "joint_velocity_actuator" : {"joint_ids" : [0, 1], "max_velocity" : 7}
                }
	    } 
        }
    },
    "virtual_space" : {
	"name" : "torus2D",
	"params" : {
		"H" : 8,
		"W" : 8,
		"threshold" : 1,
		"randomize_neighbors" : false,  
		"tau_st" : 20,
	       "tau_ori" : 20 
	},
	"controller" : {"name" : "neural_controller", "topology" : "comm_ann"},
        "landmarks" : {"num_lmarks" : 24, "scale" : 1.5, "positions" : [
		[1.0, 0.0],
	       [0.7, 0.7],
	       [0.0, 1.0],
	       [-0.7, 0.7],
	       [-1.0, 0.0],
	       [-0.7, -0.7],
	       [-0.0, -1.0],
	       [0.7, -0.7],
	       [2.0, 0.0],
	       [1.9, 0.8],
	       [1.4, 1.4],
	       [0.8, 1.9],
	       [-0.0, 2.0],
	       [-0.8, 1.9],
	       [-1.4, 1.4],
	       [-1.9, 0.8],
	       [-2.0, -0.0],
	       [-1.9, -0.8],
	       [-1.4, -1.4],
	       [-0.8, -1.9],
	       [0.0, -2.0],
	       [0.8, -1.9],
	       [1.4, -1.4],
	       [1.9, -0.8]
	]}}, 
    "algorithm" : {
        "name" : "NEAT",
        "population_size" : 50,
        "generations" : 200,
        "evaluation_steps" : 3000,
        "num_evaluations" : 1,
        "fitness_function" : "reward_integration",
	"targets" : [{"topology" : "comm_ann", "object" :"robotA:virtual_particle@controller"}],
	"gene_info" : {
	    "comm_ann:connections:weight:all" : {
		"normalization" : {"type": "linear", "min_val" : -5, "max_val" : 5}, 
		"initialization" : {"type" : "gaussian", "sigma" : 1},
		"mutation" : {"type" : "gaussian", "mutation_prob": 0.1, "sigma" : 0.05}},
	    "comm_ann:nodes:bias:all" : {
		"normalization" : {"type": "linear", "min_val" : -8, "max_val" : 8},
		"initialization" : {"type" : "gaussian", "sigma" : 2},
		"mutation" : {"type" : "gaussian", "mutation_prob": 0.1, "sigma" : 0.05}}
	},
	"alg_params" :{ 
	    "p_weight_mut" : 0.7, "p_node_mut" : 0.1, "p_conn_mut" : 0.2, "compatib_thresh" : 4,
	    "c1" : 0.5, "c2" : 0.5, "c3" : 2, "species_elites" : 2
	}
    }
}
