{
    "checkpoint_file" : "chk_state_comm_noHEBB",
    "topology" : {
        "dt" : 0.1,
        "time_scale" : 1,
        "stimuli": {
            "I1" : {"n" : 8, "sensor" : "yellow_light_sensor"},
            "I2" : {"n" : 8, "sensor" : "red_light_sensor"},
            "I3" : {"n" : 8, "sensor" : "distance_sensor"},
            "I4" : {"n" : 2, "sensor" : "mean_neigh_state"},
            "I5" : {"n" : 2, "sensor" : "own_state"},
            "I6" : {"n" : 1, "sensor" : "reward"}
        },
        "neuron_model" : "rate_model",
        "synapse_model" : "static_synapse",
        "ensembles": {
            "OUT_MOT" : {"n" : 2, "params" : {"activation" : "tanh"}},
            "OUT_STATE" : {"n" : 2, "params" : {"activation" : "tanh"}}},
        "outputs" : {
            "outA" : {"ensemble" : "OUT_MOT", "actuator" : "joint_velocity_actuator", "enc": "real"},
            "outB" : {"ensemble" : "OUT_STATE", "actuator" : "stateful_tx", "enc": "real"}
        },
        "synapses" :  {
            "I1-O" : {"pre":"I1","post":"OUT_MOT", "trainable":true, "p":1.0},
            "I2-O" : {"pre":"I2","post":"OUT_MOT", "trainable":true, "p":1.0},
            "I3-O" : {"pre":"I3","post":"OUT_MOT", "trainable":true, "p":1.0},
            "I4-O" : {"pre":"I4","post":"OUT_MOT", "trainable":true, "p":1.0},
            "I5-O" : {"pre":"I5","post":"OUT_MOT", "trainable":true, "p":1.0},
            "I6-O" : {"pre":"I6","post":"OUT_MOT", "trainable":true, "p":1.0},
            "I1-S" : {"pre":"I1","post":"OUT_STATE", "trainable":true, "p":1.0},
            "I2-S" : {"pre":"I2","post":"OUT_STATE", "trainable":true, "p":1.0},
            "I3-S" : {"pre":"I3","post":"OUT_STATE", "trainable":true, "p":1.0},
            "I4-S" : {"pre":"I4","post":"OUT_STATE", "trainable":true, "p":1.0},
            "I5-S" : {"pre":"I5","post":"OUT_STATE", "trainable":true, "p":1.0},
            "I6-S" : {"pre":"I6","post":"OUT_STATE", "trainable":true, "p":1.0}
        },
        "decoding" : {
            "outA" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}}
        },
        "learning_rule" : {
            "reward" : "task_switching_lights"
        }
    },
    "world": {
        "name" : "flat_world",
        "engine" : "pybullet",
        "physics_dt" : 0.08,
        "T_control" : 0.08,
        "objects" : {
            "robotA" : {
                "type" : "epuck",
                "num_instances" : 9,
                "controller" : "neural_controller",
                "sensors" : {
                    "light_sensor" : {"n_sectors" : 8, "range" : 10},
                    "distance_sensor" : {"n_sectors" : 8, "range" : 1.5},
                    "stateful_rx" : {"state_dim" : 2, "range" : 3},
                    "task_sensor" : {}
                },
                "actuators" : {
                    "joint_velocity_actuator" : {"joint_ids" : [0, 1], "max_velocity" : 4},
                    "stateful_tx" : {"state_dim" : 2, "range" : 3}  
                },
                "initializers" : {
                    "positions" : {"name" : "grid",  "params" : {"shuffle" : true}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low": 0,"high" : 6.28, "size" : 1}}
                },
                "perturbations" : {"stimuli_inhibition" : {"affected_robots": [1, 4,6,7], "stimuli" : "reward", "replace_value" : 0}},
                "params" : {"trainable" : true}
            },
            "light_yellow" : {
                "type" : "light_source",
                "num_instances": 1,
                "initializers" : {
                    "positions" : {"name" : "fixed", "params" : {"fixed_values": [[4, 4, 1]]}}
                },
                "params" : {"range" : 5, "color" : "yellow"}
            },
            "light_red" : {
                "type" : "light_source",
                "num_instances": 1,
                "initializers" : {
                    "positions" : {"name" : "fixed", "params" : {"fixed_values": [[-4, -4, 1]]}}
                },
                "params" : {"range" : 5, "color" : "red"}
            },
            "task_scheduler" : {
                "type" : "task_scheduler",
                "num_instances": 1,
                "params" : {"num_tasks" : 2, "num_slots" : 2, "total_timesteps" : 1000, 
                            "replacement" : false, "task_names" : ["red", "yellow"]}
            }
        }
    },
    "algorithm" : {
        "name" : "NEAT",
        "evolvable_object" : "robotA",
        "population_size" : 400,
        "generations" : 2000,
        "evaluation_steps" : 1000,
        "num_evaluations" : 1,
        "fitness_function" : "task_switching_B",
        "populations" : {
            "p1" : {
                "objects" : ["synapses:weights:all", "neurons:tau:all", "neurons:bias:all"],
                "max_vals" : [4, 0.6, 2],
                "min_vals" : [-4, -0.7, -2],
                "params" : {
                    "encoding" : "real",
                    "p_weight_mut" : 0.5,
                    "p_node_mut" : 0.1,
                    "p_conn_mut" : 0.2,
                    "compatib_thresh" : 0.3,
                    "c1" : 1,
                    "c2" : 1,
                    "c3" : 1,
                    "species_elites" : 5
                }
            }          
        }
    }
}
