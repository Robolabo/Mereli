{
    "checkpoint_file" : "chk_test_comm_sync",
    "topology" : {
        "dt" : 0.1,
        "time_scale" : 1,
        "stimuli": {
            "I1" : {"n" : 4, "sensor" : "mean_neigh_state"},
            "I2" : {"n" : 4, "sensor" : "own_state"}
        },
        "neuron_model" : "rate_model",
        "synapse_model" : "static_synapse",
        "ensembles": {
            "OUT_STATE" : {"n" : 4, "params" : {"activation" : "sigmoid"}}},
        "outputs" : {
            "outB" : {"ensemble" : "OUT_STATE", "actuator" : "stateful_tx", "enc": "real"}
        },
        "synapses" :  {
            "I1-S" : {"pre":"I1","post":"OUT_STATE", "trainable":true, "p":1.0},
            "I2-S" : {"pre":"I2","post":"OUT_STATE", "trainable":true, "p":1.0}
        },
        "decoding" : {
            "outB" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}}
        },
        "learning_rule" : {
            "reward" : null
        }
    },
    "world": {
        "name" : "square_arena",
        "arena_params" : {
            "height" : 7,
            "width" : 7
        },
        "engine" : "pybullet",
        "physics_dt" : 0.02,
        "T_control" : 0.14,
        "objects" : {
            "robotA" : {
                "type" : "epuck",
                "num_instances" : 6,
                "controller" : "neural_controller",
                "sensors" : {
                    "stateful_rx" : {"state_dim" : 4, "range" : 2}
                },
                "actuators" : {
                    "stateful_tx" : {"state_dim" : 4, "range" : 2}  
                },
                "initializers" : {
                    "positions" : {"name" : "random_uniform",  "params" : {"low": [-3,-3],"high" : [3, 3], "size" : 2}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low": 0,"high" : 6.28, "size" : 1}}
                },
                "perturbations" : {},
                "params" : {"trainable" : true}
            }
        }
    },
    "algorithm" : {
        "name" : "NEAT",
        "evolvable_object" : "robotA",
        "population_size" : 100,
        "generations" : 2000,
        "evaluation_steps" : 200,
        "num_evaluations" : 10,
        "fitness_function" : "comm_sync",
        "populations" : {
            "p1" : {
                "objects" : ["synapses:weights:all", "neurons:bias:all",  "neurons:tau:all"],
                "max_vals" : [5, 4, 1.2],
                "min_vals" : [-5, -4, -0.8],
                "params" : {
                    "encoding" : "real",
                    "p_weight_mut" : 0.1,
                    "p_node_mut" : 0.05,
                    "p_conn_mut" : 0.1,
                    "compatib_thresh" : 0.2,
                    "c1" : 1,
                    "c2" : 1,
                    "c3" : 1,
                    "species_elites" : 2
                }
            }          
        }
    }
}
