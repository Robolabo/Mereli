{
    "checkpoint_file" : "chk_commA",
    "topology" : {
        "dt" : 0.1,
        "time_scale" : 1,
        "stimuli": {
            "I1" : {"n" : 8, "sensor" : "yellow_light_sensor"},
            "I2" : {"n" : 8, "sensor" : "red_light_sensor"},
            "I3" : {"n" : 8, "sensor" : "distance_sensor"},
            "I5" : {"n" : 5, "sensor" : "comm_rx_a"},
            "I6" : {"n" : 1, "sensor" : "task"}
        },
        "neuron_model" : "rate_model",
        "synapse_model" : "static_synapse",
        "ensembles": {
            "MOT" : {"n" : 2, "params" : {"activation" : "tanh"}},
            "COMM" : {"n" : 1, "params" : {"activation" : "sigmoid"}}},
        "outputs" : {
            "outA" : {"ensemble" : "MOT", "actuator" : "joint_velocity_actuator", "enc": "real"},
            "outB" : {"ensemble" : "COMM", "actuator" : "comm_tx_a", "enc": "real"}
        },
        "synapses" :  {
            "I1-O" : {"pre":"I1","post":"MOT", "trainable":true, "p":1.0},
            "I2-O" : {"pre":"I2","post":"MOT", "trainable":true, "p":1.0},
            "I3-O" : {"pre":"I3","post":"MOT", "trainable":true, "p":1.0},
            "I5-O" : {"pre":"I5","post":"MOT", "trainable":true, "p":1.0},
            "I6-O" : {"pre":"I6","post":"MOT", "trainable":true, "p":1.0},
            "I1-S" : {"pre":"I1","post":"COMM", "trainable":true, "p":1.0},
            "I2-S" : {"pre":"I2","post":"COMM", "trainable":true, "p":1.0},
            "I3-S" : {"pre":"I3","post":"COMM", "trainable":true, "p":1.0},
            "I5-S" : {"pre":"I5","post":"COMM", "trainable":true, "p":1.0},
            "I6-S" : {"pre":"I6","post":"COMM", "trainable":true, "p":1.0}
        },
        "decoding" : {
            "outA" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}},
            "outB" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}}
        },
        "learning_rule" : {}
    },
    "world": {
        "name" : "flat_world",
        "engine" : "pybullet",
        "physics_dt" : 0.04,
        "T_control" : 0.04,
        "task_manager" : {
            "total_duration" : 2500,
            "num_slots" : 2,
            "use_done" : false,
            "tasks" : [
                {"name" : "goto_light", "params" : {"color" : "red", "range" : 0.5}},
                {"name" : "goto_light", "params" : {"color" : "yellow", "range" : 0.5}}
            ]
        },
        "objects" : {
            "robotA" : {
                "type" : "epuck",
                "num_instances" : 3,
                "controller" : "neural_controller",
                "reward" : "task_switching_lights",
                "sensors" : {
                    "light_sensor" : {"n_sectors" : 8, "range" : 3},
                    "distance_sensor" : {"n_sectors" : 8, "range" : 0.75},
                    "comm_rx_a" : {"n" : 5, "range" : 20},
                    "collision_sensor" : {}
                },
                "actuators" : {
                    "joint_velocity_actuator" : {"joint_ids" : [0, 1], "max_velocity" : 8},
                    "comm_tx_a" : {"n" : 5, "range" : 20} 
                },
                "initializers" : {
                    "positions" : {"name" : "grid",  "params" : {"shuffle" : true}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low": 0,"high" : 6.28, "size" : 1}}
                },
                "perturbations" : {"stimuli_inhibition" : {"affected_robots": [1,2,3,4], "stimuli" : "task", "replace_value" : 0}},
                "params" : {"trainable" : true}
            },
            "light_yellow" : {
                "type" : "light_source",    
                "num_instances": 1,
                "initializers" : {
                    "positions" : {"name" : "fixed", "params" : {"fixed_values": [[0.75, 0.75, 0.15]]}}
                },
                "params" : {"range" : 3, "color" : "yellow"}
            },
            "light_red" : {
                "type" : "light_source",
                "num_instances": 1,
                "initializers" : {
                    "positions" : {"name" : "fixed", "params" : {"fixed_values": [[-0.75, -0.75, 0.15]]}}
                },
                "params" : {"range" : 3, "color" : "red"}
            }
        }
    },
    "algorithm" : {
        "name" : "NEAT",
        "evolvable_object" : "robotA",
        "population_size" : 100,
        "generations" : 1000,
        "evaluation_steps" : 3000,
        "num_evaluations" : 4,
        "fitness_function" : "task_switch",
        "gene_info" : {
            "connections:weight:all" : {
                "normalization" : {"type": "linear", "min_val" : -10, "max_val" : 10}, 
                "initialization" : {"type" : "gaussian", "sigma" : 0.6},
                "mutation" : {"type" : "gaussian", "mutation_prob": 0.4, "sigma" : 0.02}},
            "nodes:bias:all" : {
                "normalization" : {"type": "linear", "min_val" : -3, "max_val" : 3}, 
                "initialization" : {"type" : "gaussian", "sigma" : 0.4},
                "mutation" : {"type" : "gaussian", "mutation_prob": 0.4, "sigma" : 0.02}},
            "nodes:gain:all" : {
                "normalization" : {"type": "linear", "min_val" : 1, "max_val" : 5}, 
                "initialization" : {"type" : "gaussian", "sigma" : 0.1},
                "mutation" : {"type" : "gaussian", "mutation_prob": 0.1, "sigma" : 0.01}},
            "nodes:tau:all" : {
                "normalization" : {"type": "linear", "min_val" : 0.5, "max_val" : 20},
                "initialization" : {"type" : "exponential", "sigma" : 1},
                "mutation" : {"type" : "gaussian", "mutation_prob": 0.3, "sigma" : 0.02}}
        },
        "alg_params" : {
            "p_weight_mut" : 0.4,
            "p_node_mut" : 0.05,
            "p_conn_mut" : 0.2,
            "compatib_thresh" : 1.4,
            "c1" : 1,
            "c2" : 1,
            "c3" : 1,
            "species_elites" : 2
        }
    }
}
