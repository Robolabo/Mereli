{
    "checkpoint_file" : "chk_SNES_state_comm",
    "topology" : {
        "dt" : 0.1,
        "time_scale" : 1,
        "stimuli": {
            "I1" : {"n" : 8, "sensor" : "yellow_light_sensor"},
            "I2" : {"n" : 8, "sensor" : "red_light_sensor"},
            "I3" : {"n" : 8, "sensor" : "distance_sensor"},
            "I4" : {"n" : 2, "sensor" : "mean_neigh_state"},
            "I5" : {"n" : 2, "sensor" : "own_state"},
            "I6" : {"n" : 1, "sensor" : "reward"}
        },
        "neuron_model" : "rate_model",
        "synapse_model" : "static_synapse",
        "ensembles": {
            "H1" : {"n" : 10, "params" : {"activation" : "sigmoid"}},
            "H2" : {"n" : 5, "params" : {"activation" : "sigmoid"}},
            "H3" : {"n" : 10, "params" : {"activation" : "sigmoid"}},
            "OUT_MOT" : {"n" : 2, "params" : {"activation" : "tanh"}},
            "OUT_STATE" : {"n" : 2, "params" : {"activation" : "tanh"}}},
        "outputs" : {
            "outA" : {"ensemble" : "OUT_MOT", "actuator" : "joint_velocity_actuator", "enc": "real"},
            "outB" : {"ensemble" : "OUT_STATE", "actuator" : "stateful_tx", "enc": "real"}
        },
        "synapses" :  {
            "I1-H1" : {"pre":"I1","post":"H1", "trainable":true, "p":1.0},
            "I2-H1" : {"pre":"I2","post":"H1", "trainable":true, "p":1.0},
         
            "I4-H1" : {"pre":"I4","post":"H2", "trainable":true, "p":1.0},
            "I5-H1" : {"pre":"I5","post":"H2", "trainable":true, "p":1.0},

                     
            "I3-H3" : {"pre":"I3","post":"H3", "trainable":true, "p":1.0},
            "I6-H1" : {"pre":"I6","post":"H1", "trainable":true, "p":1.0},
            "I6-H2" : {"pre":"I6","post":"H2", "trainable":true, "p":1.0},
            "I6-H3" : {"pre":"I6","post":"H3", "trainable":true, "p":1.0},

            "H1-H2" : {"pre":"H1","post":"H2", "trainable":true, "p":1.0},
            "H2-H3" : {"pre":"H2","post":"H3", "trainable":true, "p":1.0},
            "H3-H3" : {"pre":"H3","post":"H3", "trainable":true, "p":1.0},
            "H3-MOT" : {"pre":"H3","post":"OUT_MOT", "trainable":true, "p":1.0},
            "H3-ST" : {"pre":"H3","post":"OUT_STATE", "trainable":true, "p":1.0}
        },
        "decoding" : {
            "outA" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}}
        },
        "learning_rule" : {
            
        }
    },
    "world": {
        "name" : "flat_world",
        "engine" : "pybullet",
        "physics_dt" : 0.04,
        "T_control" : 0.04,
        "objects" : {
            "robotA" : {
                "type" : "epuck",
                "num_instances" : 1,
                "controller" : "neural_controller",
                "reward" : "task_switching_lights",
                "sensors" : {
                    "light_sensor" : {"n_sectors" : 8, "range" : 3},
                    "distance_sensor" : {"n_sectors" : 8, "range" : 0.75},
                    "stateful_rx" : {"state_dim" : 2, "range" : 2},
                    "task_sensor" : {}
                },
                "actuators" : {
                    "joint_velocity_actuator" : {"joint_ids" : [0, 1], "max_velocity" : 5},
                    "stateful_tx" : {"state_dim" : 2, "range" : 2}  
                },
                "initializers" : {
                    "positions" : {"name" : "grid",  "params" : {"shuffle" : true}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low": 0,"high" : 6.28, "size" : 1}}
                },
                "perturbations" : {},
                "params" : {"trainable" : true}
            },
            "light_yellow" : {
                "type" : "light_source",
                "num_instances": 1,
                "initializers" : {
                    "positions" : {"name" : "fixed", "params" : {"fixed_values": [[0.75, 0.75, 0.3]]}}
                },
                "params" : {"range" : 3, "color" : "yellow"}
            },
            "light_red" : {
                "type" : "light_source",
                "num_instances": 1,
                "initializers" : {
                    "positions" : {"name" : "fixed", "params" : {"fixed_values": [[-0.75, -0.75, 0.3]]}}
                },
                "params" : {"range" : 3, "color" : "red"}
            },
            "task_scheduler" : {
                "type" : "task_scheduler",
                "num_instances": 1,
                "params" : {"num_tasks" : 2, "num_slots" : 1, "total_timesteps" : 800, 
                            "replacement" : false, "task_names" : ["red", "yellow"]}
            }
        }
    },
    "algorithm" : {
        "name" : "GA",
        "evolvable_object" : "robotA",
        "population_size" : 100,
        "generations" : 2000,
        "evaluation_steps" : 800,
        "num_evaluations" : 1,
        "fitness_function" : "task_switching_B",
        "populations" : {
            "p1" : {
                "objects" : ["synapses:weights:all", "neurons:tau:all"],
                "max_vals" : [5, 0.6],
                "min_vals" : [-5, -0.7],
                "params" : {
                    "encoding" : "real",
                    "selection_operator" : "nonlin_rank",
                    "crossover_operator" : "blxalpha",
                    "mutation_operator" : "gaussian",
                    "mating_operator" : "random",
                    "mutation_prob" : 0.05,
                    "crossover_prob" : 0.9,
                    "num_elite" : 2
                }
            }          
        }
    }
}
