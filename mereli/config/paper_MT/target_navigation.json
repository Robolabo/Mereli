{
    "checkpoint_file" : "chk_target_navigation",
    "logging" : {"file" : "target_navigation"},
    "topology" : {
        "main_ann" : {
            "dt" : 0.1,
            "time_scale" : 1,
            "stimuli": {
                "I1" : {"n" : 4, "sensor" : "max_light_v"},
                "I2" : {"n" : 1, "sensor" : "reward"}
		},
            "neuron_model" : "rate_model",
            "synapse_model" : "static_synapse",
            "ensembles": {
                "OUT" : {"n" : 2, "params" : {"activation" : "tanh", "gain" : 4, "tau" : 1}}
            },
            "outputs" : {
                "outA" : {"ensemble" : "OUT", "actuator" : "joint_velocity_actuator", "enc": "real"}
            },
	    "synapses" :  {
                "I1-OUT" : {"pre":"I1","post":"OUT", "trainable":true, "p":1.0},
                "I2-OUT" : {"pre":"I2","post":"OUT", "trainable":true, "p":1.0}
            },
            "decoding" : {
                "outA" : {"scheme" : "IdentityDecoding"}
            },
            "learning_rule" : {}
        } 
    },
    "world": {
        "name" : "flat_world",
        "engine" : "pybullet",
        "physics_dt" : 0.01,
        "T_control" : 0.01,
        "task_manager" : {
            "total_duration" : 500,
            "num_slots" : 1,
            "use_done" : false,
            "tasks" : [{"name" : "reach_sensing_reference", "params" : {}}]
        },
        "objects" : {
            "robotA" : {
                "type" : "epuck",
                "num_instances" : 1,
                "controller" : {
                    "name" : "neural_controller",
                    "topology" : "main_ann",
                    "params" : {}
		},
                "sensors" : {
                    "light_sensor" : {"n_sectors" : 8, "range" : 20}
                },
                "actuators" : {
                    "joint_velocity_actuator" : {"joint_ids" : [0, 1], "max_velocity" : 10}
                },
                "initializers" : {
                    "positions" : {"name" : "random_graph",  "params" : {"max_rad": 2,"initial_pos" : [0,0]}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low": 0,"high" : 6.28, "size" : 1}}
                },
                "perturbations" : {},
                "params" : {"trainable" : true}
	    },
            "light_red" : {
                "type" : "light_source",
                "num_instances": 1,
                "initializers" : {
                    "positions" : {"name" : "fixed", "params" : {"fixed_values": [[-1, -1, 1]]}}
                },
                "params" : {"range" : 10, "color" : "red"}
            },
            "light_yellow" : {
                "type" : "light_source",
                "num_instances": 1,
                "initializers" : {
                    "positions" : {"name" : "fixed", "params" : {"fixed_values": [[1, 1, 1]]}}
                },
                "params" : {"range" : 10, "color" : "yellow"}
            },
            "light_blue" : {
                "type" : "light_source",
                "num_instances": 1,
                "initializers" : {
                    "positions" : {"name" : "fixed", "params" : {"fixed_values": [[1, -1, 1]]}}
                },
                "params" : {"range" : 10, "color" : "blue"}
            },
            "light_green" : {
                "type" : "light_source",
                "num_instances": 1,
                "initializers" : {
                    "positions" : {"name" : "fixed", "params" : {"fixed_values": [[-1, 1, 1]]}}
                },
                "params" : {"range" : 10, "color" : "green"}
            }
        }
    },
    "algorithm" : {
        "name" : "NEAT",
        "population_size" : 50,
        "generations" : 200,
        "evaluation_steps" : 3000,
        "num_evaluations" : 1,
        "fitness_function" : "reward_integration",
	"targets" : [{"topology" : "main_ann", "object" :"robotA:controller@neural_network"}],
	"gene_info" : {
	    "main_ann:connections:weight:all" : {
		"normalization" : {"type": "linear", "min_val" : -5, "max_val" : 5}, 
		"initialization" : {"type" : "gaussian", "sigma" : 1},
		"mutation" : {"type" : "gaussian", "mutation_prob": 0.1, "sigma" : 0.05}},
	    "main_ann:nodes:bias:all" : {
		"normalization" : {"type": "linear", "min_val" : -5, "max_val" : 5},
		"initialization" : {"type" : "gaussian", "sigma" : 1},
		"mutation" : {"type" : "gaussian", "mutation_prob": 0.1, "sigma" : 0.05}}
	},
	"alg_params" : {
	    "p_weight_mut" : 0.7, "p_node_mut" : 0.1, "p_conn_mut" : 0.2, "compatib_thresh" : 3.6,
	    "c1" : 0.5, "c2" : 0.5, "c3" : 2, "species_elites" : 2
	}
    }
}
