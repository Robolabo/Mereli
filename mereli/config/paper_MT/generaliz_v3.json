{
    "checkpoint_file" : "chk_generaliz_v3",
    "created" : "2023-01-25",
    "description" : "Exp that uses the comm. framework to solve task alloc with random landmarks. If differs from v2 in that here we try to solve the connectivity issue with a new consensus plane (OK or NO_OK). Unlike v2, this exp was created in ESP.",
    "logging" : {"file" : "generaliz_v3"},
    "topology" : {
        "main_ann" : {
            "dt" : 0.1,
            "time_scale" : 1,
            "stimuli": {
                "I1" : {"n" : 5, "sensor" : "neigh_dist_lmarks"},
                "I2" : {"n" : 5, "sensor" : "own_dist_lmarks"}
		},
            "neuron_model" : "rate_model",
            "synapse_model" : "static_synapse",
            "ensembles": {
                "OUT_COMM" : {"n" : 2, "params" : {"activation" : "tanh", "gain" : 4, "tau" : 1}}
            },
            "outputs" : {
                "outA" : {"ensemble" : "OUT_COMM", "actuator" : "ori_stateful_tx", "enc": "real"}
            },
            "synapses" :  {
                "I1-ORI" : {"pre":"I1","post":"OUT_COMM", "trainable":true, "p":1.0},
                "I2-ORI" : {"pre":"I2","post":"OUT_COMM", "trainable":true, "p":1.0}
            },
            "decoding" : {
                "outA" : {"scheme" : "IdentityDecoding"}
            },
            "learning_rule" : {}
        } 
    },
    "world": {
        "name" : "flat_world",
        "engine" : "pybullet",
        "physics_dt" : 0.05,
        "T_control" : 0.05,
        "task_manager" : {
            "total_duration" : 2000,
            "num_slots" : 1,
            "use_done" : false,
            "tasks" : [{"name" : "comm_formation", "params" : {"n_points" : 5, "points" : "random"}}]
        },
        "objects" : {
            "robotA" : {
                "type" : "epuck",
                "num_instances" : 5,
                "controller" : {
                    "name" : "neural_controller",
                    "topology" : "main_ann",
                    "params" : {}},
                "sensors" : {
                    "ori_stateful_rx_new" : {"state_dim" : 2, "range" : 2, "use_estimation" : true}
                },
                "actuators" : {
                    "ori_stateful_tx" : {"state_dim" : 2, "tau_st" : 10, "tau_ori" : 10, "init_state" : "random", "init_ori" : "random",  "range" : 2},
                    "led_actuator" : {}
                },
                "initializers" : {
                    "positions" : {"name" : "random_graph",  "params" : {"max_rad": 2,"initial_pos" : [0,0]}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low": 0,"high" : 6.28, "size" : 1}}
                },
                "perturbations" : {},
                "params" : {"trainable" : true}
	    }
        }
    },
    "algorithm" : {
        "name" : "NEAT",
        "population_size" : 50,
        "generations" : 200,
        "evaluation_steps" : 3000,
        "num_evaluations" : 1,
        "fitness_function" : "reward_integration",
	"targets" : [{"topology" : "main_ann", "object" :"robotA:controller@neural_network"}],
	"gene_info" : {
	    "main_ann:connections:weight:all" : {
		"normalization" : {"type": "linear", "min_val" : -8, "max_val" : 8}, 
		"initialization" : {"type" : "gaussian", "sigma" : 2},
		"mutation" : {"type" : "gaussian", "mutation_prob": 0.1, "sigma" : 0.05}},
	    "main_ann:nodes:bias:all" : {
		"normalization" : {"type": "linear", "min_val" : -8, "max_val" : 8},
		"initialization" : {"type" : "gaussian", "sigma" : 2},
		"mutation" : {"type" : "gaussian", "mutation_prob": 0.1, "sigma" : 0.05}}
	},
	"alg_params" : {
	    "p_weight_mut" : 0.4, "p_node_mut" : 0.05, "p_conn_mut" : 0.2, "compatib_thresh" : 3,
	    "c1" : 0.5, "c2" : 0.5, "c3" : 2, "species_elites" : 2
	}
    }
}
