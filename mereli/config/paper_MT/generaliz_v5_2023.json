{
    "checkpoint_file" : "chk_generaliz_v5",
    "logging" : {
	"file" : "generaliz_v5_20",
	"data": [
	"robotA@position","robotA@orientation", "robotA:virtual_particle@state",
       	"robotA:virtual_particle@orientation", "virtual_space@landmarks" 

	]
    },
    "simulation" : {
	 "timesteps" : 10000,
	 "trials" : 1,
	 "start_paused" : true,
	 "animated_layout" : {
		"enabled" : false, 
		"grid" : "A;.",
	 	"plots" : [
			{"plot_type" : "comm_space",  "name" : "A"}
		] 
	 }
    },
    "topology" : {
        "comm_ann" : {
            "dt" : 0.1,
            "time_scale" : 1,
            "stimuli": {
                "I1" : {"n" : 1, "sensor" : "dist_clst_st"},
                "I2" : {"n" : 1, "sensor" : "phi_clst_st"},
                "I3" : {"n" : 1, "sensor" : "dist_clst_lmark"},
                "I4" : {"n" : 1, "sensor" : "phi_clst_lmark"},
                "I5" : {"n" : 1, "sensor" : "dist_clst_lmark_av"},
                "I6" : {"n" : 1, "sensor" : "phi_clst_lmark_av"}
  		},
            "neuron_model" : "rate_model",
            "synapse_model" : "static_synapse",
            "ensembles": {
                "CONTROL" : {"n" : 2, "params" : {"activation" : "tanh", "gain" : 1, "tau" : 1}}
            },
            "outputs" : {
                "out" : {"ensemble" : "CONTROL", "actuator" : "control", "enc": "real"}
            },
            "synapses" :  {
                "I1-CONTROL" : {"pre":"I1","post":"CONTROL", "trainable":true, "p":1.0},
                "I2-CONTROL" : {"pre":"I2","post":"CONTROL", "trainable":true, "p":1.0},
                "I3-CONTROL" : {"pre":"I3","post":"CONTROL", "trainable":true, "p":1.0},
                "I4-CONTROL" : {"pre":"I4","post":"CONTROL", "trainable":true, "p":1.0},
                "I5-CONTROL" : {"pre":"I5","post":"CONTROL", "trainable":true, "p":1.0},
                "I6-CONTROL" : {"pre":"I6","post":"CONTROL", "trainable":true, "p":1.0}
            },
            "decoding" : {
                "out" : {"scheme" : "IdentityDecoding"}
            },
            "learning_rule" : {}
        } 
    },
    "world": {
        "name" : "flat_world",
        "arena_params" : {},
        "engine" : "pybullet",
        "physics_dt" : 0.05,
        "T_control" : 0.05,
        "task_manager" : {
            "total_duration" : 100000,
            "num_slots" : 1,
            "use_done" : false,
            "tasks" : [{"name" : "comm_formation", "params" : {"threshold" : 0.2}}]
        },
        "objects" : {
            "robotA" : {
                "type" : "epuck",
                "num_instances" : 4,
		"positions" : {"type" : "random", "low" : [-0.25, -0.25], "high" : [0.25,0.25]}, 
		"orientations" : "random",
                "controller" : {
                    "name" : "forage_comm_space",
                    "params" : {}},
                "sensors" : {
                    "distance_sensor" : {"range" : 0.8},
                    "light_sensor" : {"range" : 4},
		    "own_position_sensor" : {},
		    "battery_sensor" : {},
		    "memory_ground_sensor" : {}
                },
                "actuators" : {
                    "joint_velocity_actuator" : {}
                },
		"battery" : true
	    },
	    "red_light" : {
                "type" : "light_source",
                "num_instances" : 1,
		"positions" : [0,1,0.5],
		"params" : {"range" : 5, "color" : "red"}
	    },
	    "nest" : {
                "type" : "ground_area",
                "num_instances" : 1,
		"positions" : [0,0,0],
		"params" : {"radius" : 0.5, "color" : "black"}
	    },
	    "food" : {
                "type" : "ground_area",
                "num_instances" : 2,
		"positions" : [[2,0,0], [-2,0,0]],
		"params" : {"radius" : 0.2, "color" : "grey"}
	    }
        }
    },
    "virtual_space" : {
	"name" : "torus2D",
	"params" : {
		"H" : 2,
		"W" : 2,
		"num_lmarks" : 5,
		"threshold" : 0.4,
		"randomize_neighbors" : false,  
		"tau_st" : 10,
	       "tau_ori" : 10  
	},
	"controller" : {"name" : "neural_controller", "topology" : "comm_ann"},
        "landmarks" : {"n_lmarks" : 5, "positions" : "random"}	}, 
    "algorithm" : {
        "name" : "NEAT",
        "population_size" : 50,
        "generations" : 200,
        "evaluation_steps" : 3000,
        "num_evaluations" : 5,
        "fitness_function" : "reward_integration",
	"targets" : [{"topology" : "comm_ann", "object" :"robotA:virtual_particle@controller"}],
	"gene_info" : {
	    "comm_ann:connections:weight:all" : {
		"normalization" : {"type": "linear", "min_val" : -5, "max_val" : 5}, 
		"initialization" : {"type" : "gaussian", "sigma" : 1},
		"mutation" : {"type" : "gaussian", "mutation_prob": 0.1, "sigma" : 0.05}},
	    "comm_ann:nodes:bias:all" : {
		"normalization" : {"type": "linear", "min_val" : -5, "max_val" : 5},
		"initialization" : {"type" : "gaussian", "sigma" : 1},
		"mutation" : {"type" : "gaussian", "mutation_prob": 0.1, "sigma" : 0.05}}
	},
	"alg_params" :{ 
	    "p_weight_mut" : 0.5, "p_node_mut" : 0.1, "p_conn_mut" : 0.2, "compatib_thresh" : 4,
	    "c1" : 0.5, "c2" : 0.5, "c3" : 2, "species_elites" : 2
	}
    }
}
