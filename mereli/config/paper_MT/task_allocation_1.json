{
    "checkpoint_file" : "chk_task_allocation_1",
    "topology" : {
        "main_ann" : {
            "dt" : 0.1,
            "time_scale" : 1,
            "stimuli": {
                "I1" : {"n" : 5, "sensor" : "mean_neigh_state"},
                "I2" : {"n" : 5, "sensor" : "own_state"}
            },
            "neuron_model" : "rate_model",
            "synapse_model" : "static_synapse",
            "ensembles": {
                "OUT_COMM" : {"n" : 5, "params" : {"activation" : "sigmoid", "tau" : 1}},
                "OUT_TASK" : {"n" : 5, "params" : {"activation" : "sigmoid", "tau" : 1}}
            },
            "outputs" : {
                "outB" : {"ensemble" : "OUT_COMM", "actuator" : "stateful_tx", "enc": "real"},
                "outA" : {"ensemble" : "OUT_TASK", "actuator" : "led_actuator"}
            },
            "synapses" :  {
                "I1-C" : {"pre":"I1","post":"OUT_COMM", "trainable":true, "p":1.0},
                "I1-T" : {"pre":"I1","post":"OUT_TASK", "trainable":true, "p":1.0},
                "I2-C" : {"pre":"I2","post":"OUT_COMM", "trainable":true, "p":1.0},
                "I2-T" : {"pre":"I2","post":"OUT_TASK", "trainable":true, "p":1.0},
                "T-T" : {"pre":"OUT_TASK","post":"OUT_TASK", "trainable":true, "p":1.0},
                "C-C" : {"pre":"OUT_COMM","post":"OUT_COMM", "trainable":true, "p":1.0}
            },
            "decoding" : {
                "outB" : {"scheme" : "IdentityDecoding"},
                "outA" : {"scheme" : "SoftmaxDecoding"}
            },
            "learning_rule" : {}
        } 
    },
    "world": {
        "name" : "flat_world",
        "engine" : "pybullet",
        "physics_dt" : 0.05,
        "T_control" : 0.05,
        "task_manager" : {
            "total_duration" : 300,
            "num_slots" : 1,
            "use_done" : false,
            "tasks" : [{"name" : "task_allocation", "params" : {"num_tasks" : 5, "agents_per_task": 1}}]
        },
        "objects" : {
            "robotA" : {
                "type" : "epuck",
                "num_instances" : 5,
                "controller" : {
                    "name" : "neural_controller",
                    "topology" : "main_ann",
                    "params" : {}},
                "sensors" : {
                    "stateful_rx" : {"state_dim" : 5, "range" : 1.2}
                },
                "actuators" : {
                    "stateful_tx" : {"state_dim" : 5, "range" : 1.2},
                    "led_actuator" : {}
                },
                "initializers" : {
                    "positions" : {"name" : "random_graph",  "params" : {"max_rad": 1,"initial_pos" : [0,0]}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low": 0,"high" : 6.28, "size" : 1}}
                },
                "perturbations" : {},
                "params" : {"trainable" : true}
            }
        }
    },
    "algorithm" : {
        "name" : "NEAT",
        "population_size" : 150,
        "generations" : 1000,
        "evaluation_steps" : 3000,
        "num_evaluations" : 1,
        "fitness_function" : "reward_integration",
	"targets" : [{"topology" : "main_ann", "object" :"robotA:controller@neural_network"}],
	"gene_info" : {
	    "main_ann:connections:weight:all" : {
		"normalization" : {"type": "linear", "min_val" : -3, "max_val" : 3}, 
		"initialization" : {"type" : "gaussian", "sigma" : 1},
		"mutation" : {"type" : "gaussian", "mutation_prob": 0.8, "sigma" : 0.05}}
	},
	"alg_params" : {
	    "p_weight_mut" : 0.4, "p_node_mut" : 0.2, "p_conn_mut" : 0.2, "compatib_thresh" : 1.5,
	    "c1" : 1, "c2" : 1, "c3" : 1, "species_elites" : 2
	}
    }
}
