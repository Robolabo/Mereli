{
    "checkpoint_file" : "chk_leader_SNES_final_V2",
    "num_processes" : 1,
    "render" : false,
    "topology" : {
        "dt" : 0.1,
        "time_scale" : 30,
        "stimuli": {
            "W1" : {"n" : 2, "sensor" : "wireless_receiver:msg"},
            "W3" : {"n" : 1, "sensor" : "wireless_receiver:state"},
            "W4" : {"n" : 2, "sensor" : "wireless_receiver:receiving_direction"}
        },
        "encoding" : {
            "W1" :{"scheme" : "IdentityEncoding", "receptive_field" : {}},
            "W3" :{"scheme" : "IdentityEncoding", "receptive_field" : {}},
            "W4" :{"scheme" : "IdentityEncoding", "receptive_field" : {}}
        },
        "neurons" : {"model": "ctrnn", "params": {"tau":0.35, "gain" : 1.0}},
        "ensembles": {
            "C1" : {"n" : 10, "tau" : 10, "gain" : 1, "bias": 0, "activation":"sigmoid"},
            "C2" : {"n" : 10, "tau" : 10, "gain" : 1, "bias": 0, "activation":"sigmoid"},
            "OUT_COMM" : {"n" : 2, "tau" : 8, "gain" : 2, "bias": 0, "activation":"sigmoid"},
            "OUT_COMM_STATE" : {"n" : 1, "tau" : 8, "gain" : 2, "bias": 0, "activation":"sigmoid"},
            "OUT_LED" : {"n" : 1, "tau" : 10, "gain" : 2, "bias": 0, "activation":"sigmoid"}
        },
        "outputs" : {
            "outA" : {"ensemble" : ["OUT_COMM"], "actuator" : "IR_transmitter", "enc": "real"},
            "outC" : {"ensemble" : ["OUT_COMM_STATE"], "actuator" : "IR_transmitter:state", "enc": "cat"},
            "outB" : {"ensemble" : ["OUT_LED"], "actuator" : "led_actuator", "enc": "cat"}
        },
        "synapses" :  {
            "W1-c1" : {"pre":"W1","post":"C1", "trainable":true, "p":1},
            "W3-c1" : {"pre":"W3","post":"C1", "trainable":true, "p":1},
            "W4-c1" : {"pre":"W4","post":"C1", "trainable":true, "p":1},
            "W1-c2" : {"pre":"W1","post":"C2", "trainable":true, "p":1},
            "W3-c2" : {"pre":"W3","post":"C2", "trainable":true, "p":1},
            "W4-c2" : {"pre":"W4","post":"C2", "trainable":true, "p":1},

            "c1-c1" : {"pre":"C1","post":"C1", "trainable":true, "p":0.7},
            "c2-c2" : {"pre":"C2","post":"C2", "trainable":true, "p":0.7},
            "c1-c2" : {"pre":"C1","post":"C2", "trainable":true, "p":0.7},

            "c1-led" : {"pre":"C1","post":"OUT_LED", "trainable":true, "p":1},
            "c2-comm" : {"pre":"C2","post":"OUT_COMM", "trainable":true, "p":1},
            "c2-st" : {"pre":"C2","post":"OUT_COMM_STATE", "trainable":true, "p":1},

            "comm-c1" : {"pre":"OUT_COMM","post":"C1", "trainable":true, "p":1},
            "led-c1" : {"pre":"OUT_LED","post":"C1", "trainable":true, "p":1},
            "st-c1" : {"pre":"OUT_COMM_STATE","post":"C1", "trainable":true, "p":1},

            "comm-comm" : {"pre":"OUT_COMM","post":"OUT_COMM", "trainable":true, "p":1}
        },
        "decoding" : {
            "outA" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}},
            "outC" : {"scheme" : "ThresholdDecoding", "params" : {"is_cat" : true}},
            "outB" : {"scheme" : "ThresholdDecoding", "params" : {"is_cat" : true, "stochastic":true}}
        } 
    },
    "algorithm" : {
        "name" : "GA",
        "evolvable_object" : "robotA",
        "population_size" : 100,
        "generations" : 5000,
        "evaluation_steps" : 300,
        "num_evaluations" : 1,
        "fitness_function" : "identify_leader",
        "populations" : {
            "p4" : {
                "objects" : ["synapses:weights:all", "neurons:bias:all",  "neurons:tau:all"],
                "max_vals" : [3,  1.5, 0.75],
                "min_vals" : [-3, -1.5, -1],
                "encoding" : "real",
                "selection_operator" : "tournament",
                "crossover_operator" : "blxalpha",
                "mutation_operator" : "gaussian",
                "mating_operator" : "random",
                "mutation_prob" : 0.05,
                "crossover_prob" : 0.9,
                "num_elite" : 3
            }          
        }
    },
    "world":{
        "world_delay" : 1,
        "render_connections":true,
        "height":1000,
        "width": 1000,
        "objects" : {
            "robotA" : {
                "type" : "robot",
                "num_instances" : 10,
                "controller" : "neural_controller",
                "sensors" : {"wireless_receiver" : {"n_sectors" : 4, "range" : 100, "msg_length" : 2}},
                "actuators" : {"led_actuator" : {}, "IR_transmitter" : {"quantize": true, "range" : 100, "msg_length":2}},
                "initializers" : {
                    "positions" : {"name" : "random_graph", "params" : {"max_rad":100, "initial_pos" : [500, 500]}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low":0, "high" : 6.28, "size" : 1}}
                },
                "perturbations" : {"leader_failure" : {"time_to_failure": 50}},
                "params" : {"trainable" : true}
            }
        }
    }
}
