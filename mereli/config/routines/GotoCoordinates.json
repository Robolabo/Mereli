{
    "simulation" : {
	 "timesteps" : 10000,
	 "trials" : 1,
	 "start_paused" : false, 
	 "animated_layout" : {
		"enabled" : false,
		"grid" : "AA;CC",
	 	"plots" : [
			{"plot_type" : "custom_lineplot", "variables":["sensors:goal_coordinates_sensor@reading"],  "name" : "A"},
			{"plot_type" : "animated_ann",  "name" : "C"}
		] 
	 }
    },
    "checkpoint_file" : "chk_goto_coords",
    "topology" : { "main_ann" : {
            "dt" : 0.1,
            "stimuli": {
                "I1" : {"n" : 1, "sensor" : "compass"},
                "I2" : {"n" : 2, "sensor" : "goal_coordinates_sensor"}
            },
            "neuron_model" : "rate_model",
            "synapse_model" : "static_synapse",
            "ensembles": {
                "OUT" : {"n" : 2, "params" : {"activation" : "tanh"}}
            },
            "outputs" : {
                "joint_velocity_actuator" : {"ensemble" : "OUT"}
            },
            "synapses" :  {
                "s1" : {"pre":"I1","post":"OUT", "trainable":true, "p":1.0},
                "s2" : {"pre":"I2","post":"OUT", "trainable":true, "p":1.0}
	    } 
        } 
    },
    "world": {
        "name" : "square_arena",
        "arena_params" : {"height" : 4,  "width" : 4},
        "engine" : "pybullet",
        "physics_dt" : 0.05,
        "T_control" : 0.05,
        "task_manager" : {
            "total_duration" : 200,
            "num_slots" : 1,
            "use_done" : false,
            "tasks" : [{"name" : "goto_coordinates", "params" : {}}]
        },
        "objects" : {
            "robotA" : {
                "type" : "epuck",
                "num_instances" : 1,
		"positions" : [0,0,0], 
		"orientations" : "random",
                "controller" : {
                    "name" : "neural_controller",
                    "topology" : "main_ann",
                    "params" : {"checkpoint" : null}},
                "sensors" : {
                   "distance_sensor" : {"range" :0.8}, 
                   "goal_coordinates_sensor" : {"goal_coordinates" : "random"}, 
                   "gps" : {},
		  "compass" : {} 
                },
                "actuators" : {
                    "joint_velocity_actuator" : {"joint_ids" : [0, 1], "max_velocity" : 6.28}
                }
            }
        }
    },
    "algorithm" : {
        "name" : "GA",
        "population_size" : 50,
        "generations" : 200,
        "evaluation_steps" : 3000,
        "num_evaluations" : 10,
        "fitness_function" : "reward_integration",
	"targets" : [{"topology" : "main_ann", "object" :"robotA:controller@neural_network"}],
	"gene_info" : {
	    "main_ann:connections:weight:all" : {
		"normalization" : {"type": "linear", "min_val" : -3, "max_val" : 3}, 
		"initialization" : {"type" : "gaussian", "sigma" : 1},
		"mutation" : {"type" : "gaussian", "mutation_prob": 0.01, "sigma" : 0.5}},
	    "main_ann:nodes:bias:all" : {
		"normalization" : {"type": "linear", "min_val" : -2, "max_val" : 2},
		"initialization" : {"type" : "gaussian", "sigma" : 0.5},
		"mutation" : {"type" : "gaussian", "mutation_prob": 0.01, "sigma" : 0.5}}
	},
	"alg_params" :{ 
		"crossover" : "blxalpha"
	}
    }
}
