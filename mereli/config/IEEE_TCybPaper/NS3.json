{
    "checkpoint_file" : "chk_NS3",
    "topology" : {
        "dt" : 0.1,
        "time_scale" : 1,
        "stimuli": {
            "I1" : {"n" : 8, "sensor" : "distance_sensor"},
            "I2" : {"n" : 4, "sensor" : "comm_rx_a"}
        },
        "neuron_model" : "rate_model",
        "synapse_model" : "static_synapse",
        "ensembles": {
            "OUT_MOT" : {"n" : 2, "params" : {"activation" : "tanh"}},
            "COMM" : {"n" : 1, "params" : {"activation" : "sigmoid"}}
        },
        "outputs" : {
            "outA" : {"ensemble" : "OUT_MOT", "actuator" : "joint_velocity_actuator", "enc": "real"},
            "outB" : {"ensemble" : "COMM", "actuator" : "comm_tx_a", "enc": "real"}
        },
        "synapses" :  {
            "I1-O" : {"pre":"I1","post":"OUT_MOT", "trainable":true, "p":1.0},
            "I1-C" : {"pre":"I1","post":"COMM", "trainable":true, "p":1.0},
            "I2-O" : {"pre":"I2","post":"OUT_MOT", "trainable":true, "p":1.0},
            "I2-C" : {"pre":"I2","post":"COMM", "trainable":true, "p":1.0}
        },
        "decoding" : {
            "outA" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}},
            "outB" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}}
        },
        "learning_rule" : {
        }
    },
    "world": {
        "name" : "custom_world",
        "arena_params" : {
            "map_file" : "crossroad/crossroad"
        },
        "engine" : "pybullet",
        "physics_dt" : 0.03,
        "T_control" : 0.03,
        "task_manager" : {
            "total_duration" : 2500,
            "num_slots" : 1,
            "use_done" : false,
            "tasks" : [{"name" : "dummy", "params" : {}}]
        },        
        "objects" : {   
            "robotA" : {
                "type" : "epuck",
                "num_instances" : 4,
                "controller" : "neural_controller",
                "sensors" : {
                    "distance_sensor" : {"n_sectors" : 8, "range" : 0.1},
                    "comm_rx_a" : {"n" : 4, "range" : 20}
                },
                "actuators" : {
                    "joint_velocity_actuator" : {"joint_ids" : [0, 1], "max_velocity" : 5},
                    "comm_tx_a" : {"n" : 4, "range" : 20},
                    "led_actuator" : {}
                },
                "initializers" : {
                    "positions" : {"name" : "fixed",  "params" : {"fixed_values" : [[0,-0.6], [0,0.6], [-0.6,0], [0.6,0]]}},
                    "orientations" : {"name" : "fixed",  "params" : {"fixed_values" : [1.57, -1.57, 0, 3.14]}}
                },
                "perturbations" : {},
                "params" : {"trainable" : true}
            }
        }
    },
    "algorithm" : {
        "name" : "NEAT",
        "evolvable_object" : "robotA",
        "population_size" : 50,
        "generations" : 1000,
        "evaluation_steps" : 3000,
        "num_evaluations" : 1,
        "fitness_function" : null,
        "novelty_search" : {
            "variable" : "positions",
            "weight" : 1
        },
        "gene_info" : {
            "connections:weight:all" : {
                "normalization" : {"type": "linear", "min_val" : -10, "max_val" : 10}, 
                "initialization" : {"type" : "gaussian", "sigma" : 0.6},
                "mutation" : {"type" : "gaussian", "mutation_prob": 0.4, "sigma" : 0.02}},
            "nodes:bias:all" : {
                "normalization" : {"type": "linear", "min_val" : -3, "max_val" : 3}, 
                "initialization" : {"type" : "gaussian", "sigma" : 0.4},
                "mutation" : {"type" : "gaussian", "mutation_prob": 0.4, "sigma" : 0.02}},
            "nodes:gain:all" : {
                "normalization" : {"type": "linear", "min_val" : 1, "max_val" : 5}, 
                "initialization" : {"type" : "gaussian", "sigma" : 0.1},
                "mutation" : {"type" : "gaussian", "mutation_prob": 0.1, "sigma" : 0.01}},
            "nodes:tau:all" : {
                "normalization" : {"type": "linear", "min_val" : 0.5, "max_val" : 20},
                "initialization" : {"type" : "exponential", "sigma" : 1},
                "mutation" : {"type" : "gaussian", "mutation_prob": 0.3, "sigma" : 0.02}}
        },
        "alg_params" : {
            "p_weight_mut" : 0.4,
            "p_node_mut" : 0.07,
            "p_conn_mut" : 0.2,
            "compatib_thresh" : 1.4,
            "c1" : 1,
            "c2" : 1,
            "c3" : 1,
            "species_elites" : 2
        }
    }
}
