{
    "checkpoint_file" : "chk_task_allocation_openai",
    "topology" : {
        "main_ann" : {
            "dt" : 0.1,
            "time_scale" : 1,
            "stimuli": {
                "I1" : {"n" : 3, "sensor" : "mean_neigh_state"},
                "I2" : {"n" : 3, "sensor" : "own_state"},
                "I3" : {"n" : 1, "sensor" : "sin_signal"}
            },
            "neuron_model" : "rate_model",
            "synapse_model" : "static_synapse",
            "ensembles": {
                "OUT_COMM" : {"n" : 3, "params" : {"activation" : "sigmoid", "tau" : 1}},
                "OUT_TASK" : {"n" : 3, "params" : {"activation" : "sigmoid", "tau" : 1}},
                "H" : {"n" : 10, "params" : {"activation" : "sigmoid", "tau" : 1}},
                "H2" : {"n" : 5, "params" : {"activation" : "sigmoid", "tau" : 1}}
            },
            "outputs" : {
                "outB" : {"ensemble" : "OUT_COMM", "actuator" : "stateful_tx", "enc": "real"},
                "outA" : {"ensemble" : "OUT_TASK", "actuator" : "led_actuator"}
            },
            "synapses" :  {
                "I1-H" : {"pre":"I1","post":"H", "trainable":true, "p":1.0},
                "I2-H" : {"pre":"I2","post":"H", "trainable":true, "p":1.0},
                "I3-H" : {"pre":"I3","post":"H", "trainable":true, "p":1.0},
                "H-H2" : {"pre":"H","post":"H2", "trainable":true, "p":1.0},
		
                "C-C" : {"pre":"OUT_COMM","post":"OUT_COMM", "trainable":true, "p":1.0},
                "T-T" : {"pre":"OUT_TASK","post":"OUT_TASK", "trainable":true, "p":1.0},
                "H-C" : {"pre":"H2","post":"OUT_COMM", "trainable":true, "p":1.0},
                "H-T" : {"pre":"H2","post":"OUT_TASK", "trainable":true, "p":1.0}
            },
            "decoding" : {
                "outB" : {"scheme" : "IdentityDecoding"},
                "outA" : {"scheme" : "SoftmaxDecoding"}
            },
            "learning_rule" : {}
        } 
    },
    "world": {
        "name" : "flat_world",
        "engine" : "pybullet",
        "physics_dt" : 0.05,
        "T_control" : 0.05,
        "task_manager" : {
            "total_duration" : 500,
            "num_slots" : 1,
            "use_done" : false,
            "tasks" : [{"name" : "task_allocation", "params" : {"num_tasks" : 3, "agents_per_task": 1}}]
        },
        "objects" : {
            "robotA" : {
                "type" : "epuck",
                "num_instances" : 3,
                "controller" : {
                    "name" : "neural_controller",
                    "topology" : "main_ann",
                    "params" : {}},
                "sensors" : {
                    "stateful_rx" : {"state_dim" : 3, "range" : 4}
                },
                "actuators" : {
                    "stateful_tx" : {"state_dim" : 3, "range" : 4},
                    "led_actuator" : {}
                },
                "initializers" : {
                    "positions" : {"name" : "random_uniform",  "params" : {"low": [-1,-1],"high" : [1,1], "size" : 2}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low": 0,"high" : 6.28, "size" : 1}}
                },
                "perturbations" : {},
                "params" : {"trainable" : true}
            }
        }
    },
    "algorithm" : {
        "name" : "multi_EA",
        "population_size" : 100,
        "generations" : 1000,
        "evaluation_steps" : 3000,
        "num_evaluations" : 3,
        "fitness_function" : "reward_integration",
        "algs" : {
            "neat_1" : {
                "name" : "openai_es", 
                "targets" : [{"topology" : "main_ann", "object" :"robotA:controller@neural_network"}],
                "gene_info" : {
                    "main_ann:connections:weight:all" : {
                        "normalization" : {"type": "linear", "min_val" : -5, "max_val" : 5}, 
                        "initialization" : {"type" : "gaussian", "sigma" : 1.5},
                        "mutation" : {"type" : "gaussian", "mutation_prob": 0.6, "sigma" : 0.07}}
                },
                "alg_params" : {"learning_rate" : 0.07}
            }
        }
    }
}
