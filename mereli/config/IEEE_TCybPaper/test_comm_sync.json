{
    "checkpoint_file" : "chk_test_comm_sync",
    "topology" : {
        "dt" : 0.1,
        "time_scale" : 1,
        "stimuli": {
            "I1" : {"n" : 2, "sensor" : "mean_neigh_state"},
            "I2" : {"n" : 2, "sensor" : "own_state"}
        },
        "neuron_model" : "rate_model",
        "synapse_model" : "static_synapse",
        "ensembles": {
            "OUT_STATE" : {"n" : 2, "params" : {"activation" : "tanh"}}},
        "outputs" : {
            "outB" : {"ensemble" : "OUT_STATE", "actuator" : "stateful_tx", "enc": "real"}
        },
        "synapses" :  {
            "I1-S" : {"pre":"I1","post":"OUT_STATE", "trainable":true, "p":1.0},
            "I2-S" : {"pre":"I2","post":"OUT_STATE", "trainable":true, "p":1.0}
        },
        "decoding" : {
            "outB" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}}
        },
        "learning_rule" : {
            "reward" : null
        }
    },
    "world": {
        "name" : "square_arena",
        "arena_params" : {
            "height" : 7,
            "width" : 7
        },
        "engine" : "pybullet",
        "physics_dt" : 0.02,
        "T_control" : 0.14,
        "objects" : {
            "robotA" : {
                "type" : "epuck",
                "num_instances" : 3,
                "controller" : "neural_controller",
                "sensors" : {
                    "stateful_rx" : {"state_dim" : 2, "range" : 3},
                    "task_sensor" : {}
                },
                "actuators" : {
                    "stateful_tx" : {"state_dim" : 2, "range" : 3}  
                },
                "initializers" : {
                    "positions" : {"name" : "random_uniform",  "params" : {"low": [-1,-1],"high" : [1, 1], "size" : 2}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low": 0,"high" : 6.28, "size" : 1}}
                },
                "perturbations" : {},
                "params" : {"trainable" : true}
            },
            "task_scheduler" : {
                "type" : "task_scheduler",
                "num_instances": 1,
                "params" : {"num_tasks" : 2, "num_slots" : 1, "total_timesteps" : 150, 
                            "replacement" : false, "task_names" : ["red", "yellow"]}
            }
        }
    },
    "algorithm" : {
        "name" : "NEAT",
        "evolvable_object" : "robotA",
        "population_size" : 100,
        "generations" : 2000,
        "evaluation_steps" : 150,
        "num_evaluations" : 5,
        "fitness_function" : "comm_sync",
        "populations" : {
            "p1" : {
                "objects" : ["synapses:weights:all"],
                "max_vals" : [5],
                "min_vals" : [-5],
                "params" : {
                    "encoding" : "real",
                    "p_weight_mut" : 0.1,
                    "p_node_mut" : 0.01,
                    "p_conn_mut" : 0.1,
                    "compatib_thresh" : 0.4,
                    "c1" : 1,
                    "c2" : 1,
                    "c3" : 1,
                    "species_elites" : 2
                }
            }          
        }
    }
}
