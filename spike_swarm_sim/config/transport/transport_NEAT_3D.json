{
    "checkpoint_file" : "chk_transport_NEAT_3D",
    "topology" : {
        "dt" : 0.1,
        "time_scale" : 1,
        "stimuli": {
            "I00" : {"n" : 4, "sensor" : "color_sensor"},
            "I0" : {"n" : 1, "sensor" : "ground_sensor"},
            "I1" : {"n" : 4, "sensor" : "light_sensor3D"},
            "I2" : {"n" : 4, "sensor" : "IR_receiver:msg"},
            "I3" : {"n" : 4, "sensor" : "distance_sensor3D"},
            "I4" : {"n" : 1, "sensor" : "RF_receiver:msg"},
            "I5" : {"n" : 1, "sensor" : "RF_receiver:signal"}
        },
        "neuron_model" : "rate_model",
        "synapse_model" : "static_synapse",
        "ensembles": {
            "OUT_COMM" : {"n" : 1, "params" : {"tau": 0.5}},
            "OUT_RF" : {"n" : 1, "params" : {"tau": 0.5}},
            "OUT_MOT" : {"n" : 2, "params" : {"activation" : "tanh"}}
        },
        "outputs" : {
            "outA" : {"ensemble" : "OUT_MOT", "actuator" : "joint_velocity_actuator", "enc": "real"},
            "outB" : {"ensemble" : "OUT_COMM", "actuator" : "wireless_transmitter", "enc": "real"},
            "outC" : {"ensemble" : "OUT_RF", "actuator" : "RF_transmitter", "enc": "cat"}
        },
        "synapses" :  {
            "I0-MOT" : {"pre":"I0","post":"OUT_MOT", "trainable":true, "p":1.0},
            "I00-MOT" : {"pre":"I00","post":"OUT_MOT", "trainable":true, "p":1.0},
            "I1-MOT" : {"pre":"I1","post":"OUT_MOT", "trainable":true, "p":1.0},
            "I2-MOT" : {"pre":"I2","post":"OUT_MOT", "trainable":true, "p":1.0},
            "I3-MOT" : {"pre":"I3","post":"OUT_MOT", "trainable":true, "p":1.0},
            "I4-MOT" : {"pre":"I4","post":"OUT_MOT", "trainable":true, "p":1.0},
            "I5-MOT" : {"pre":"I5","post":"OUT_MOT", "trainable":true, "p":1.0},
    
            "I0-COMM" : {"pre":"I0","post":"OUT_COMM", "trainable":true, "p":1.0},
            "I00-COMM" : {"pre":"I00","post":"OUT_COMM", "trainable":true, "p":1.0},
            "I1-COMM" : {"pre":"I1","post":"OUT_COMM", "trainable":true, "p":1.0},
            "I2-COMM" : {"pre":"I2","post":"OUT_COMM", "trainable":true, "p":1.0},
            "I3-COMM" : {"pre":"I3","post":"OUT_COMM", "trainable":true, "p":1.0},
            "I4-COMM" : {"pre":"I4","post":"OUT_COMM", "trainable":true, "p":1.0},
            "I5-COMM" : {"pre":"I5","post":"OUT_COMM", "trainable":true, "p":1.0},

            "I0-RF" : {"pre":"I0","post":"OUT_RF", "trainable":true, "p":1.0},
            "I00-RF" : {"pre":"I00","post":"OUT_RF", "trainable":true, "p":1.0},
            "I1-RF" : {"pre":"I1","post":"OUT_RF", "trainable":true, "p":1.0},
            "I2-RF" : {"pre":"I2","post":"OUT_RF", "trainable":true, "p":1.0},
            "I3-RF" : {"pre":"I3","post":"OUT_RF", "trainable":true, "p":1.0},
            "I4-RF" : {"pre":"I4","post":"OUT_RF", "trainable":true, "p":1.0},
            "I5-RF" : {"pre":"I5","post":"OUT_RF", "trainable":true, "p":1.0}
        },
        "decoding" : {
            "outA" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}},
            "outB" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}},
            "outC" : {"scheme" : "ThresholdDecoding", "params" : {"is_cat" : true}}   
        }, 
        "learning_rule" : { 
            "rule" : "generalized_hebbian",
            "reward" : "transport_cube"
        }
    },
    "algorithm" : {
        "name" : "NEAT",
        "evolvable_object" : "robotA",
        "population_size" : 400,
        "generations" : 2000,
        "evaluation_steps" : 2000,
        "num_evaluations" : 1,
        "fitness_function" : "transport_cubes",
        "populations" : {
            "p1" : {
                "objects" : ["synapses:weights:sensory",  "neurons:bias:all",  "neurons:tau:all",  "learning_rule:params:all"],
                "max_vals" : [3,  2, 1, 3],
                "min_vals" : [-3, -2, -0.8, -3],
                "params" : {
                    "encoding" : "real",
                    "p_weight_mut" : 0.4,
                    "p_node_mut" : 0.15,
                    "p_conn_mut" : 0.2,
                    "compatib_thresh" : 3,
                    "c1" : 0.1,
                    "c2" : 0.1, 
                    "c3" : 1
                }
            }          
        }
    },
    "world":{
        "engine" : "3D",
        "world_delay" : 1,
        "render_connections":true,
        "height":10,
        "width": 10,
        "objects" : {
            "robotA" : {
                "type" : "robot",
                "num_instances" : 4,
                "controller" : "neural_controller",
                "sensors" : {
                    "color_sensor" : {"n_sectors" : 4, "range" : 5},
                    "light_sensor3D" : {"n_sectors" : 4, "range" : 20, "noise_sigma" : 0.03},
                    "IR_receiver" : {"n_sectors" : 4, "range" : 2, "msg_length" : 1,  "noise_sigma" : 0.03},
                    "distance_sensor3D" : {"n_sectors" : 4, "range" : 2, "noise_sigma" : 0.03},
                    "RF_receiver" : {"n_sectors" : 1, "range" : 20, "noise_sigma" : 2},
                    "ground_sensor" : {}
                },
                "actuators" : {
                    "joint_velocity_actuator" : {"joint_ids" : [0, 1], "max_velocity" : 15},
                    "wireless_transmitter" : {"quantize": false, "range" : 2, "msg_length":1},
                    "RF_transmitter" : {"range" : 20}
                },
                "initializers" : {
                    "positions" : {"name" : "random_uniform", "params" : {"low": [-4, -2], "high" : [4, -4], "size" : 2 }},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low":0, "high" : 6.28, "size" : 1}}
                },
                "perturbations" : {"stimuli_inhibition" : {"affected_robots": 0, "stimuli" : "light_sensor3D"}},
                "params" : {"trainable" : true}
            },            
            "light_red" : {
                "type" : "light_source",
                "num_instances": 1,
                "initializers" : {
                    "positions" : {"name" : "fixed", "params" : {"fixed_values": [[0, 3]]}}
                },
                "params" : {"range" : 20, "color" : "red"}
            },
            "ground_area_grey" : {
                "type" : "ground_area",
                "num_instances": 1,
                "initializers" : {
                    "positions" : {"name" : "fixed", "params" : {"fixed_values": [[0, 3]]}}
                },
                "params" : {"radius" : 1.5, "color" : "grey"}
            },
            "cube_blue" : {
                "type" : "cube",
                "num_instances": 4,
                "initializers" : {
                    "positions" : {"name" : "random_uniform", "params" : {"low": [-3, -1], "high" : [3, 1], "size" : 2 }}
                },
                "params" : {"mass" : 1, "side_len" : 0.5, "color" : "blue"}
            }
        }
    }
}
