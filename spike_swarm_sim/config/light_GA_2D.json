{
    "checkpoint_file" : "chk_light_GA_2D",
    "topology" : {
        "dt" : 0.1,
        "time_scale" : 20,
        "stimuli": {
            "I1" : {"n" : 4, "sensor" : "light_sensor"},
            "I2" : {"n" : 2, "sensor" : "IR_receiver:msg"},
            "I3" : {"n" : 2, "sensor" : "IR_receiver:receiving_direction"},
            "I4" : {"n" : 1, "sensor" : "IR_receiver:state"},
            "I5" : {"n" : 4, "sensor" : "distance_sensor"}
        },
        "neuron_model" : "rate_model",
        "synapse_model" : "static_synapse",
        "ensembles": {
            "H1" : {"n" : 20, "params" : {}},
            "OUT_COMM" : {"n" : 1, "params" : {"tau": 0.5}},
            "OUT_COMM_STATE" : {"n" : 1, "params" : {"tau": 0.5}},
            "OUT_MOT" : {"n" : 2, "params" : {"activation" : "tanh"}}
        },
        "outputs" : {
            "outA" : {"ensemble" : "OUT_MOT", "actuator" : "wheel_actuator", "enc": "real"},
            "outB" : {"ensemble" : "OUT_COMM", "actuator" : "wireless_transmitter", "enc": "real"},
            "outC" : {"ensemble" : "OUT_COMM_STATE", "actuator" : "wireless_transmitter:state", "enc": "real"}
        },
        "synapses" :  {
            "I1-H1" : {"pre":"I1","post":"H1", "trainable":true, "p":1.0},
            "I2-H1" : {"pre":"I2","post":"H1", "trainable":true, "p":1.0},
            "I3-H1" : {"pre":"I3","post":"H1", "trainable":true, "p":1.0},
            "I4-H1" : {"pre":"I4","post":"H1", "trainable":true, "p":1.0},
            "I5-H1" : {"pre":"I5","post":"H1", "trainable":true, "p":1.0},

            "H1-H1" : {"pre":"H1","post":"H1", "trainable":true, "p":1.0},
            "H1-MOT" : {"pre":"H1","post":"OUT_MOT", "trainable":true, "p":1.0},
            "H1-ST" : {"pre":"H1","post":"OUT_COMM_STATE", "trainable":true, "p":1.0},
            "H1-COMM" : {"pre":"H1","post":"OUT_COMM", "trainable":true, "p":1.0},

            "MOT-H1" : {"pre":"OUT_MOT","post":"H1", "trainable":true, "p":1.0},
            "COMM-H1" : {"pre":"OUT_COMM","post":"H1", "trainable":true, "p":1.0},
            "ST-H1" : {"pre":"OUT_COMM_STATE","post":"H1", "trainable":true, "p":1.0}
        },
        "decoding" : {
            "outA" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}},
            "outB" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}},
            "outC" : {"scheme" : "ThresholdDecoding", "params" : {"is_cat" : true}}   
        } 
    },
    "algorithm" : {
        "name" : "GA",
        "evolvable_object" : "robotA",
        "population_size" : 300,
        "generations" : 2000,
        "evaluation_steps" : 800,
        "num_evaluations" : 3,
        "fitness_function" : "goto_light",
        "populations" : {
            "p1" : {
                "objects" : ["synapses:weights:all", "neurons:bias:all",  "neurons:tau:all"],
                "max_vals" : [3,  1.5, 1.25],
                "min_vals" : [-3, -1.5, -0.8],
                "params" : {
                    "encoding" : "real",
                    "selection_operator" : "tournament",
                    "crossover_operator" : "blxalpha",
                    "mutation_operator" : "gaussian",
                    "mating_operator" : "random",
                    "mutation_prob" : 0.1,
                    "crossover_prob" : 0.9,
                    "num_elite" : 5
                }
            }          
        }
    },
    "world":{
        "engine" : "2D",
        "world_delay" : 1,
        "render_connections":true,
        "height":15,
        "width": 15,
        "objects" : {
            "robotA" : {
                "type" : "robot",
                "num_instances" : 4,
                "controller" : "neural_controller",
                "sensors" : {
                    "light_sensor" : {"n_sectors" : 4, "range" : 20},
                    "IR_receiver" : {"n_sectors" : 4, "range" : 2, "msg_length" : 2, "selection_scheme" : "random"},
                    "distance_sensor" : {"n_sectors" : 4, "range" : 2}
                },
                "actuators" : {
                    "wheel_actuator" : {},
                    "wireless_transmitter" : {"quantize": true, "range" : 2, "msg_length":2}
                },
                "initializers" : {
                    "positions" : {"name" : "random_graph", "params" : {"max_rad": 3, "initial_pos" : [0, 0]}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low":0, "high" : 6.28, "size" : 1}}
                },
                "perturbations" : {"stimuli_inhibition" : {"affected_robots": 3, "stimuli" : "light_sensor3D"}},
                "params" : {"trainable" : true}
            },
            "light_red" : {
                "type" : "light_source",
                "num_instances": 1,
                "controller" : "light_orbit_controller",
                "initializers" : {
                    "positions" : {"name" : "random_uniform", "params" : {"low":-1, "high" : 1, "size" : 2}}
                },
                "params" : {"range" : 20, "color" : "red"}
            }
        }
    }
}
