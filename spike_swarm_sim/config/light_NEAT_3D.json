{
    "checkpoint_file" : "chk_light_NEAT_3D",
    "topology" : {
        "dt" : 0.1,
        "time_scale" : 30,
        "stimuli": { 
            "I2" : {"n" : 4, "sensor" : "IR_receiver:msg"},
            "I3" : {"n" : 2, "sensor" : "IR_receiver:receiving_direction"},
            "I5" : {"n" : 1, "sensor" : "IR_receiver:signal"},
            "I1" : {"n" : 4, "sensor" : "light_sensor3D"}
        },
        "neuron_model" : "rate_model",
        "synapse_model" : "static_synapse",
        "ensembles": {
            "OUT_COMM" : {"n" : 4, "params" : {"tau": 0.5}},
            "OUT_MOT" : {"n" : 2, "params" : {"activation" : "tanh"}}
        },
        "outputs" : {
            "outA" : {"ensemble" : "OUT_MOT", "actuator" : "joint_velocity_actuator", "enc": "real"},
            "outB" : {"ensemble" : "OUT_COMM", "actuator" : "wireless_transmitter", "enc": "real"}
        },
        "synapses" :  {
            "I1-MOT" : {"pre":"I1","post":"OUT_MOT", "trainable":true, "p":1.0},
            "I2-MOT" : {"pre":"I2","post":"OUT_MOT", "trainable":true, "p":1.0},
            "I3-MOT" : {"pre":"I3","post":"OUT_MOT", "trainable":true, "p":1.0},
            "I5-MOT" : {"pre":"I5","post":"OUT_MOT", "trainable":true, "p":1.0},
    
            "I1-COMM" : {"pre":"I1","post":"OUT_COMM", "trainable":true, "p":1.0},
            "I2-COMM" : {"pre":"I2","post":"OUT_COMM", "trainable":true, "p":1.0},
            "I3-COMM" : {"pre":"I3","post":"OUT_COMM", "trainable":true, "p":1.0},
            "I5-COMM" : {"pre":"I5","post":"OUT_COMM", "trainable":true, "p":1.0}
        },
        "decoding" : {
            "outA" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}},
            "outB" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}}
        }
    },
    "algorithm" : {
        "name" : "NEAT",
        "evolvable_object" : "robotA",
        "population_size" : 200,
        "generations" : 2000,
        "evaluation_steps" : 800,
        "num_evaluations" : 1,
        "fitness_function" : "goto_light",
        "populations" : {
            "p1" : {
                "objects" : ["synapses:weights:all", "neurons:bias:all",  "neurons:tau:all"],
                "max_vals" : [3,  1.5, 1.25],
                "min_vals" : [-3, -1.5, -0.8],
                "params" : {
                    "encoding" : "real",
                    "p_weight_mut" : 0.5,
                    "p_node_mut" : 0.1,
                    "p_conn_mut" : 0.2,
                    "compatib_thresh" : 0.5,
                    "c1" : 1,
                    "c2" : 1,
                    "c3" : 0.5
                }
            }          
        }
    },
    "world":{
        "engine" : "3D",
        "world_delay" : 1,
        "render_connections":true,
        "height":10,
        "width": 10,
        "objects" : {
            "robotA" : {
                "type" : "robot",
                "num_instances" : 3,
                "controller" : "neural_controller",
                "sensors" : {
                    "light_sensor3D" : {"n_sectors" : 4, "range" : 20},
                    "IR_receiver" : {"n_sectors" : 4, "range" : 10, "msg_length" : 4, "selection_scheme" : "random"},
                    "distance_sensor3D" : {"n_sectors" : 4, "range" : 4}
                },
                "actuators" : {
                    "joint_velocity_actuator" : {"joint_ids" : [0, 1], "max_velocity" : 15},
                    "wireless_transmitter" : {"quantize": true, "range" : 10, "msg_length":4, "K" : 2}
                },
                "initializers" : {
                    "positions" : {"name" : "random_graph", "params" : {"max_rad": 3, "initial_pos" : [0, 0]}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low":0, "high" : 6.28, "size" : 1}}
                },
                "perturbations" : {"stimuli_inhibition" : {"affected_robots": [1, 2], "stimuli" : "light_sensor3D"}},
                "params" : {"trainable" : true}
            },            
            "light_red" : {
                "type" : "light_source",
                "num_instances": 1,
                "controller" : "light_orbit_controller",
                "initializers" : {
                    "positions" : {"name" : "random_uniform", "params" : {"low": -1, "high" : 1, "size" : 2 }}
                },
                "params" : {"range" : 20, "color" : "red"}
            }
        }
    }
}
