{
    "checkpoint_file" : "chk_alignment_SNES_final",
    "num_processes" : 1,
    "render" : false,
    "topology" : {
        "dt" : 0.1,
        "time_scale" : 20,
        "stimuli": {
            "W1" : {"n" : 2, "sensor" : "wireless_receiver:msg"},
            "W3" : {"n" : 2, "sensor" : "wireless_receiver:sending_direction"},
            "W5" : {"n" : 2, "sensor" : "wireless_receiver:receiving_direction"}
        },
        "encoding" : {
            "W1" :{"scheme" : "IdentityEncoding", "receptive_field" : {}},
            "W3" :{"scheme" : "IdentityEncoding", "receptive_field" : {}},
            "W5" :{"scheme" : "IdentityEncoding", "receptive_field" : {}}
        },
        "neuron_model" : "rate_model",
        "synapse_model" : "static_synapse",
        "ensembles": {
            "C" : {"n" : 5, "params" : {}},
            "C1" : {"n" : 10, "params" : {}},
            "C2" : {"n" : 10, "params" : {}},
            "OUT_COMM" : {"n" : 2, "params" : {}},
            "OUT_COMM_STATE" : {"n" : 1, "params" : {}},
            "OUT_MOT" : {"n" : 1, "params" : {"activation":"tanh"}}
        },
        "outputs" : {
            "outA" : {"ensemble" : "OUT_COMM", "actuator" : "wireless_transmitter", "enc": "real"},
            "outC" : {"ensemble" : "OUT_COMM_STATE", "actuator" : "wireless_transmitter:state", "enc": "cat"},
            "outB" : {"ensemble" : "OUT_MOT", "actuator" : "wheel_actuator", "enc": "real"}
        },
        "synapses" :  {
            "W1-c" : {"pre":"W1","post":"C", "trainable":true, "p":1.0},
            "W3-c" : {"pre":"W3","post":"C", "trainable":true, "p":1.0},
            "W5-c" : {"pre":"W5","post":"C", "trainable":true, "p":1.0},
            "W1-c1" : {"pre":"W1","post":"C1", "trainable":true, "p":1.0},
            "W3-c1" : {"pre":"W3","post":"C1", "trainable":true, "p":1.0},
            "W5-c1" : {"pre":"W5","post":"C1", "trainable":true, "p":1.0},
            "c-c" : {"pre":"C","post":"C", "trainable":true, "p":0.8},
            "c1-c1" : {"pre":"C1","post":"C1", "trainable":true, "p":0.7},
            "c2-c2" : {"pre":"C2","post":"C2", "trainable":true, "p":0.7},
            "c1-c2" : {"pre":"C1","post":"C2", "trainable":true, "p":0.7},

            "c-mot" : {"pre":"C","post":"OUT_MOT", "trainable":true, "p":1.0},
            "c2-comm" : {"pre":"C2","post":"OUT_COMM", "trainable":true, "p":1.0},
            "c2-st" : {"pre":"C2","post":"OUT_COMM_STATE", "trainable":true, "p":1.0},

            "comm-c" : {"pre":"OUT_COMM","post":"C", "trainable":true, "p":1.0},
            "mot-c" : {"pre":"OUT_MOT","post":"C", "trainable":true, "p":1.0},
            "st-c" : {"pre":"OUT_COMM_STATE","post":"C", "trainable":true, "p":1.0},
            "comm-c1" : {"pre":"OUT_COMM","post":"C1", "trainable":true, "p":1.0},
            "mot-c1" : {"pre":"OUT_MOT","post":"C1", "trainable":true, "p":1.0},
            "st-c1" : {"pre":"OUT_COMM_STATE","post":"C1", "trainable":true, "p":1.0},

            "comm-comm" : {"pre":"OUT_COMM","post":"OUT_COMM", "trainable":true, "p":1.0},
            "comm-st" : {"pre":"OUT_COMM","post":"OUT_COMM_STATE", "trainable":true, "p":1.0},
            "st-comm" : {"pre":"OUT_COMM_STATE","post":"OUT_COMM", "trainable":true, "p":1.0}
        },
        "decoding" : {
            "outA" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}},
            "outC" : {"scheme" : "ThresholdDecoding", "params" : {"is_cat" : true}},
            "outB" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}}
        } 
    },
    "algorithm" : {
        "name" : "SNES",
        "evolvable_object" : "robotA",
        "population_size" : 40,
        "generations" : 5000,
        "evaluation_steps" : 600,
        "num_evaluations" : 1,
        "fitness_function" : "alignment",
        "populations" : {
            "p1" : {
                "objects" : ["synapses:weights:all", "neurons:bias:all",  "neurons:tau:all", "neurons:gain:all"],
                "max_vals" : [2,  0, 0.5, 4],
                "min_vals" : [-2, -3, -1, 0.5],
                "params" : {"encoding" : "real"}
            }          
        }
    },
    "world":{
        "world_delay" : 1,
        "render_connections":false,
        "height":1000,
        "width": 1000,
        "objects" : {
            "robotA" : {
                "type" : "robot",
                "num_instances" : 10,
                "controller" : "neural_controller",
                "sensors" : {"wireless_receiver" : {"n_sectors" : 4, "range" : 100, "msg_length" : 2}},
                "actuators" : {"wheel_actuator" : {"min_thresh" : 0.05}, "wireless_transmitter" : {"quantize": true, "range" : 100, "msg_length":2}},
                "initializers" : {
                    "positions" : {"name" : "random_graph", "params" : {"max_rad":100, "initial_pos" : [500, 500]}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low":0, "high" : 6.28, "size" : 1}}
                },
                "perturbations" : {},
                "params" : {"trainable" : true}
            }
        }
    }
}
