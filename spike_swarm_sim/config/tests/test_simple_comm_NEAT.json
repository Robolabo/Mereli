{
    "checkpoint_file" : "chk_test_simple_comm_NEAT",
    "topology" : {
        "dt" : 0.1,
        "time_scale" : 1,
        "stimuli": {
            "I0" : {"n" : 4, "sensor" : "IR_receiver:msg"},
            "I1" : {"n" : 1, "sensor" : "task_sensor"}
        },
        "neuron_model" : "rate_model",
        "synapse_model" : "static_synapse",
        "ensembles": {
            "H" : {"n" : 10, "params" : {"tau": 0.5}},
            "OUT_COMM" : {"n" : 1, "params" : {"tau": 0.5}},
            "OUT_LED" : {"n" : 1, "params" : {"tau": 0.5}}
        },
        "outputs" : {
            "outB" : {"ensemble" : "OUT_COMM", "actuator" : "wireless_transmitter", "enc": "real"},
            "outC" : {"ensemble" : "OUT_LED", "actuator" : "led_actuator_3D", "enc": "cat"}
        },
        "synapses" :  {
            "I0-H" : {"pre":"I0","post":"H", "trainable":true, "p":1.0},
            "I1-H" : {"pre":"I1","post":"H", "trainable":true, "p":1.0},

            "H-LED" : {"pre":"H","post":"OUT_LED", "trainable":true, "p":1.0}, 
            "H-COMM" : {"pre":"H","post":"OUT_COMM", "trainable":true, "p":1.0}

        },
        "decoding" : {
            "outB" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}},
            "outC" : {"scheme" : "ThresholdDecoding", "params" : {"is_cat" : false}}
        }
    },
    "algorithm" : {
        "name" : "GA",
        "evolvable_object" : "robotA",
        "population_size" : 50,
        "generations" : 2000,
        "evaluation_steps" : 200,
        "num_evaluations" : 5,
        "fitness_function" : "test_comm_leds",
        "populations" : {
            "p1" : {
                "objects" : ["synapses:weights:all", "neurons:bias:all",  "neurons:tau:all"],
                "max_vals" : [5,  2, 1],
                "min_vals" : [-5, -2, -0.8],
                "params" : {
                    "encoding" : "real",
                    "selection_operator" : "tournament",
                    "crossover_operator" : "blxalpha",
                    "mutation_operator" : "gaussian",
                    "mating_operator" : "random",
                    "mutation_prob" : 0.1,
                    "crossover_prob" : 1,
                    "num_elite" : 2
                }
            }          
        }
    },
    "world":{
        "engine" : "3D",
        "world_delay" : 1,
        "height":10,
        "width": 10,
        "objects" : {
            "robotA" : {
                "type" : "robot",
                "num_instances" : 4,
                "controller" : "neural_controller",
                "sensors" : {
                    "IR_receiver" : {"n_sectors" : 4, "range" : 15, "msg_length" : 1, "selection_scheme" : "cyclic"},
                    "task_sensor" : {}
                },
                "actuators" : {
                    "wireless_transmitter" : {"quantize": false, "range" : 15, "msg_length":1, "K" : 2},
                    "led_actuator_3D" : {}
                },
                "initializers" : {
                    "positions" : {"name" : "fixed",  "params" : {"fixed_values" : [[0, 0], [2, 2], [2, -2], [-2,2]]}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low":0, "high" : 6.28, "size" : 1}}
                },
                "perturbations" : {
                    "stimuli_inhibition" : {"affected_robots": [1, 2, 3], "stimuli" : "task_sensor", "replace_value" : -1}
                },
                "params" : {"trainable" : true}
            }, 
            "task_scheduler" : {
                "type" : "task_scheduler",
                "num_instances": 1,
                "params" : {"num_tasks" : 2, "num_slots" : 4, "total_timesteps" : 200, "replacement" : true}
            }
        }
    }
}
