{
    "checkpoint_file" : "chk_test_simple_comm_NEAT",
    "topology" : {
        "dt" : 0.1,
        "time_scale" : 1,
        "stimuli": {
            "I0" : {"n" : 4, "sensor" : "IR_receiver:msg"}
        },
        "neuron_model" : "rate_model",
        "synapse_model" : "static_synapse",
        "ensembles": {
            "OUT_COMM" : {"n" : 1, "params" : {"tau": 0.5}},
            "OUT_MOT" : {"n" : 2, "params" : {"activation" : "tanh"}}
        },
        "outputs" : {
            "outA" : {"ensemble" : "OUT_MOT", "actuator" : "joint_velocity_actuator", "enc": "real"},
            "outB" : {"ensemble" : "OUT_COMM", "actuator" : "wireless_transmitter", "enc": "real"}
        },
        "synapses" :  {
            "I0-MOT" : {"pre":"I0","post":"OUT_MOT", "trainable":true, "p":1.0},
            "I0-COMM" : {"pre":"I0","post":"OUT_COMM", "trainable":true, "p":1.0}
        },
        "decoding" : {
            "outA" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}},
            "outB" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}}
        }
    },
    "algorithm" : {
        "name" : "NEAT",
        "evolvable_object" : "robotA",
        "population_size" : 50,
        "generations" : 2000,
        "evaluation_steps" : 600,
        "num_evaluations" : 3,
        "fitness_function" : "test_comm_aggregation",
        "populations" : {
            "p1" : {
                "objects" : ["synapses:weights:all", "neurons:bias:all",  "neurons:tau:all"],
                "max_vals" : [5,  2, 1],
                "min_vals" : [-5, -2, -0.8],
                "params" : {
                    "encoding" : "real",
                    "p_weight_mut" : 0.1,
                    "p_node_mut" : 0.05,
                    "p_conn_mut" : 0.15,
                    "compatib_thresh" : 2,
                    "c1" : 1,
                    "c2" : 1,
                    "c3" : 0.6,
                    "species_elites" : 1
                }
            }          
        }
    },
    "world":{
        "engine" : "3D",
        "world_delay" : 1,
        "height":10,
        "width": 10,
        "objects" : {
            "robotA" : {
                "type" : "robot",
                "num_instances" : 2,
                "controller" : "neural_controller",
                "sensors" : {
                    "IR_receiver" : {"n_sectors" : 4, "range" : 15, "msg_length" : 1, "selection_scheme" : "cyclic"}
                },
                "actuators" : {
                    "joint_velocity_actuator" : {"joint_ids" : [0, 1], "max_velocity" : 12},
                    "wireless_transmitter" : {"quantize": false, "range" : 15, "msg_length":1, "K" : 2}
                },
                "initializers" : {
                    "positions" : {"name" : "fixed",  "params" : {"fixed_values" : [[0, 0], [2, 2]]}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low":0, "high" : 6.28, "size" : 1}}
                },
                "perturbations" : {
                    "stimuli_inhibition" : {"affected_robots": [1], "stimuli" : "IR_receiver:msg"}
                },
                "params" : {"trainable" : true}
            }
        }
    }
}
