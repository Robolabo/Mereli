{
    "checkpoint_file" : "minitaur_test_NEAT",
    "topology" : {
        "dt" : 0.1,
        "time_scale" : 1,
        "stimuli": {
            "I1" : {"n" : 16, "sensor" : "joint_position_sensor"}, 
            "I2" : {"n" : 3, "sensor" : "own_orientation_sensor"}
        },
        "neuron_model" : "rate_model",
        "synapse_model" : "static_synapse",
        "ensembles": {
            "OUT_MOT" : {"n" : 16, "params" : {"activation" : "tanh"}}
        },
        "outputs" : {
            "outA" : {"ensemble" : "OUT_MOT", "actuator" : "joint_position_actuator", "enc": "real"}
        },
        "synapses" :  {
            "I1-MOT" : {"pre":"I1","post":"OUT_MOT", "trainable":true, "p":1.0},
            "I2-MOT" : {"pre":"I2","post":"OUT_MOT", "trainable":true, "p":1.0}
        },
        "decoding" : {
            "outA" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}}
        } 
    },
    "algorithm" : {
        "name" : "NEAT",
        "evolvable_object" : "robotA",
        "population_size" : 100,
        "generations" : 5000,
        "evaluation_steps" : 1500,
        "num_evaluations" : 1,
        "fitness_function" : "walking",
        "populations" : {
            "p1" : {
                "objects" : ["synapses:weights:all"],
                "max_vals" : [3],
                "min_vals" : [-3],
                "params" : {"encoding" : "real"}
            }          
        }
    },
    "world":{
        "engine" : "3D",
        "world_delay" : 1,
        "render_connections":true,
        "height":20,
        "width": 20,
        "objects" : {
            "robotA" : {
                "type" : "minitaur",
                "num_instances" : 1,
                "controller" : "neural_controller",
                "sensors" : {"own_orientation_sensor": {}, "joint_position_sensor" : {"joints" : [1, 3, 4, 6, 7, 9, 10, 12, 14, 16, 17, 19, 20, 22, 23, 25]}},
                "actuators" : {"joint_position_actuator" : {"joint_ids" : [1, 3, 4, 6, 7, 9, 10, 12, 14, 16, 17, 19, 20, 22, 23, 25]}},
                "initializers" : {
                    "positions" : {"name" : "random_graph", "params" : {"max_rad": 2, "initial_pos" : [0, 0]}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low":0, "high" : 6.28, "size" : 1}}
                },
                "perturbations" : {},
                "params" : {"trainable" : true}
            }
        }
    }
}