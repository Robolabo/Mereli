{
    "checkpoint_file" : "chk_alignment_3D_SNN_SNES",
    "topology" : {
        "dt" : 0.1,
        "time_scale" : 20,
        "stimuli": {
            "I0" : {"n" : 2, "sensor" : "IR_receiver:msg"},
            "I1" : {"n" : 2, "sensor" : "IR_receiver:sending_direction"},
            "I2" : {"n" : 2, "sensor" : "IR_receiver:receiving_direction"}
        },
        "encoding" : {
            "I0" :{
                "scheme" : "LIF_Encoding",
                "receptive_field" : {
                    "name" : "gaussian_receptive_field",
                    "params" : {"n_neurons" : 4, "min_stim" : 0, "max_stim" : 1, "min_val" : 0, "max_val" : 30, "sigma" : 6, "inverted" : false}
                }
            },
            "I1" : {
                "scheme" : "LIF_Encoding",
                "receptive_field" : {
                    "name" : "gaussian_receptive_field",
                    "params" : {"n_neurons" : 3, "min_stim" : -1, "max_stim" : 1, "min_val" : 0, "max_val" : 30, "sigma" : 0.65, "inverted" : false}
                }
            },
            "I2" : {
                "scheme" : "LIF_Encoding",
                "receptive_field" : {
                    "name" : "gaussian_receptive_field",
                    "params" : {"n_neurons" : 3, "min_stim" : -1, "max_stim" : 1, "min_val" : 0, "max_val" : 30, "sigma" : 0.65, "inverted" : false}
                }
            }
        },
        "neuron_model" : "adex",
        "synapse_model" : "dynamic_synapse",
        "ensembles": {
            "H1e" : {"n" : 15, "params" : {}},
            "H1i" : {"n" : 7, "params" : {}},
            "OUT" : {"n" : 7, "params" : {}},
            "OUT_COMM" : {"n" : 7, "params" : {}}
        },
        "outputs" : {
            "out" :  {"ensemble" : "OUT", "actuator" : "joint_velocity_actuator", "enc": "real"},
            "out2" :  {"ensemble" : "OUT_COMM", "actuator" : "wireless_transmitter", "enc": "real"},
            "out3" :  {"ensemble" : "OUT_COMM", "actuator" : "wireless_transmitter:state", "enc": "cat"}
        },     
        "decoding" : {
            "out" : {
                "scheme" : "LinearPopulationDecoding", 
                "params" : {"trainable":true, "num_outputs": 1, "non_linearity" : "tanh","is_cat" : false, "rest_value" : 0.5}
            },
            "out2" : {
                "scheme" : "LinearPopulationDecoding", 
                "params" : {"trainable":true, "num_outputs": 1, "non_linearity" : "sigmoid", "is_cat" : false, "rest_value" : 0.5}
            },
            "out3" : {
                "scheme" : "LinearPopulationDecoding", 
                "params" : {"trainable":true, "num_outputs": 1, "non_linearity" : "sigmoid", "is_cat" : true, "rest_value" : 0.5}
            }
        },
        "synapses" :  {
            "I0-H1e" : {"pre":"I0","post":"H1e", "p" : 1.0, "ntx_fixed":true, "neuroTX":"AMPA+NDMA", "trainable":true},
            "I0-H1i" : {"pre":"I0","post":"H1i", "p" : 1.0, "ntx_fixed":true, "neuroTX":"AMPA+NDMA", "trainable":true},
            "I1-H1e" : {"pre":"I1","post":"H1e", "p" : 1.0, "ntx_fixed":true, "neuroTX":"AMPA+NDMA", "trainable":true},
            "I1-H1i" : {"pre":"I1","post":"H1i", "p" : 1.0, "ntx_fixed":true, "neuroTX":"AMPA+NDMA", "trainable":true},
            "I2-H1e" : {"pre":"I2","post":"H1e", "p" : 1.0, "ntx_fixed":true, "neuroTX":"AMPA+NDMA", "trainable":true},
            "I2-H1i" : {"pre":"I2","post":"H1i", "p" : 1.0, "ntx_fixed":true, "neuroTX":"AMPA+NDMA", "trainable":true},
            "H1e-H1i" : {"pre":"H1e","post":"H1i", "p" : 1.0, "ntx_fixed":true, "neuroTX":"AMPA+NDMA", "trainable":true},
            "H1i-H1e" : {"pre":"H1i","post":"H1e", "p" : 1.0, "ntx_fixed":true, "neuroTX":"GABA", "trainable":true},
            "H1e-H1e" : {"pre":"H1e","post":"H1e", "p" : 1.0, "ntx_fixed":true, "neuroTX":"AMPA+NDMA", "trainable":true},
            "H1i-H1i" : {"pre":"H1i","post":"H1i", "p" : 1.0, "ntx_fixed":true, "neuroTX":"GABA", "trainable":true},
            "H1e-OUT" : {"pre" : "H1e", "post": "OUT", "p" : 1.0, "ntx_fixed":true, "neuroTX":"AMPA+NDMA", "trainable":true},
            "H1i-OUT" : {"pre" : "H1i", "post": "OUT", "p" : 1.0, "ntx_fixed":true, "neuroTX":"GABA", "trainable":true},
            "H1e-OUT_COMM" : {"pre" : "H1e", "post": "OUT_COMM", "p" : 1.0, "ntx_fixed":true, "neuroTX":"AMPA+NDMA", "trainable":true},
            "H1i-OUT_COMM" : {"pre" : "H1i", "post": "OUT_COMM", "p" : 1.0, "ntx_fixed":true, "neuroTX":"GABA", "trainable":true},
            "OUT_COMM-H1e" : {"pre" : "OUT_COMM", "post": "H1e", "p" : 1.0, "ntx_fixed":true, "neuroTX":"AMPA+NDMA", "trainable":true}
        },
        "synapse_params": {
            "AMPA" : {"gain" : 11, "tau" : 6, "E":null},
            "GABA" : {"gain" : 8, "tau": 10, "E":null}, 
            "NDMA" : {"gain" : 3, "tau_rise" : 10, "tau_decay": 50, "Mg2" : 0.5, "E" : null}
        }
    },
    "algorithm" : {
        "name" : "SNES",
        "evolvable_object" : "robotA",
        "population_size" : 30,
        "generations" : 5000,
        "evaluation_steps" : 500,
        "num_evaluations" : 5,
        "fitness_function" : "alignment",
        "populations" : {
            "p1" : {
                "objects" : ["synapses:weights:sensory", "synapses:weights:hidden", "synapses:weights:motor", "decoders:weights:all"],
                "max_vals" : [7, 5, 5,  1],
                "min_vals" : [-7, -5, -5, -1],
                "params" : {
                    "encoding" : "real"
                }
            }
        }
    },
    "world":{
        "engine" : "3D",
        "world_delay" : 1,
        "render_connections":false,
        "height":10,
        "width": 10,
        "objects" : {
            "robotA" : {
                "type" : "robot",
                "num_instances" : 5,
                "controller" : "neural_controller",
                "sensors" : {"IR_receiver" : {"n_sectors" : 4, "range" : 1.2, "msg_length" : 2}},
                "actuators" : {
                    "joint_velocity_actuator" : {"joint_ids" : [0], "inverse_mirrored" : 1, "max_velocity":5}, 
                    "wireless_transmitter" : {"quantize": true, "range" : 1.2, "msg_length":2}
                },
                "initializers" : {
                    "positions" : {"name" : "random_graph", "params" : {"max_rad":0.5, "initial_pos" : [0, 0]}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low":0, "high" : 6.28, "size" : 1}}
                },
                "perturbations" : {},
                "params" : {"trainable" : true}
            }
        }
    }
}
