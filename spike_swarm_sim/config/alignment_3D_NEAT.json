{
    "checkpoint_file" : "chk_alignment_3D_NEAT_final",
    "topology" : {
        "dt" : 0.1,
        "time_scale" : 20,
        "stimuli": {
            "I1" : {"n" : 2, "sensor" : "IR_receiver:msg"},
            "I2" : {"n" : 2, "sensor" : "IR_receiver:sending_direction"},
            "I3" : {"n" : 2, "sensor" : "IR_receiver:receiving_direction"}
        },
        "encoding" : {
            "I1" :{"scheme" : "IdentityEncoding", "receptive_field" : {}},
            "I2" :{"scheme" : "IdentityEncoding", "receptive_field" : {}},
            "I3" :{"scheme" : "IdentityEncoding", "receptive_field" : {}}
        },
        "neuron_model" : "rate_model",
        "synapse_model" : "static_synapse",
        "ensembles": {
            "OUT_COMM" : {"n" : 2, "params" : {"tau": 0.5}},
            "OUT_COMM_STATE" : {"n" : 1, "params" : {"tau": 0.5}},
            "OUT_MOT" : {"n" : 1, "params" : {"tau": 0.5, "activation":"tanh"}}
        },
        "outputs" : {
            "outA" : {"ensemble" : "OUT_COMM", "actuator" : "wireless_transmitter", "enc": "real"},
            "outC" : {"ensemble" : "OUT_COMM_STATE", "actuator" : "wireless_transmitter:state", "enc": "cat"},
            "outB" : {"ensemble" : "OUT_MOT", "actuator" : "joint_velocity_actuator", "enc": "real"}
        },
        "synapses" :  {
            "I1-COMM" : {"pre":"I1","post":"OUT_COMM", "trainable":true, "p":1.0},
            "I2-COMM_ST" : {"pre":"I2","post":"OUT_COMM_STATE", "trainable":true, "p":1.0},
            "I3-MOT" : {"pre":"I3","post":"OUT_MOT", "trainable":true, "p":1.0}
        },
        "decoding" : {
            "outA" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}},
            "outC" : {"scheme" : "ThresholdDecoding", "params" : {"is_cat" : true}},
            "outB" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}}
        } 
    },
    "algorithm" : {
        "name" : "NEAT",
        "evolvable_object" : "robotA",
        "population_size" : 100,
        "generations" : 5000,
        "evaluation_steps" : 600,
        "num_evaluations" : 1,
        "fitness_function" : "alignment",
        "populations" : {
            "p1" : {
                "objects" : ["synapses:weights:all"],
                "max_vals" : [3],
                "min_vals" : [-3],
                "params" : {
                    "encoding" : "real",
                    "p_weight_mut" : 0.75,
                    "p_node_mut" : 0.08,
                    "p_conn_mut" : 0.1,
                    "compatib_thresh" : 2.5,
                    "c1" : 3,
                    "c2" : 2, 
                    "c3" : 2
                }
            }
        }
    },
    "world":{
        "engine" : "3D",
        "world_delay" : 1,
        "render_connections":false,
        "height":10,
        "width": 10,
        "objects" : {
            "robotA" : {
                "type" : "robot",
                "num_instances" : 5,
                "controller" : "neural_controller",
                "sensors" : {"IR_receiver" : {"n_sectors" : 4, "range" : 2, "msg_length" : 2}},
                "actuators" : {
                    "joint_velocity_actuator" : {"joint_ids" : [0], "inverse_mirrored" : 1, "max_velocity":5}, 
                    "wireless_transmitter" : {"quantize": true, "range" : 2, "msg_length":2}
                },
                "initializers" : {
                    "positions" : {"name" : "random_graph", "params" : {"max_rad":0.5, "initial_pos" : [0, 0]}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low":0, "high" : 6.28, "size" : 1}}
                },
                "perturbations" : {},
                "params" : {"trainable" : true}
            }
        }
    }
}
