{
    "checkpoint_file" : "chk_test_NEAT",
    "topology" : {
        "dt" : 0.1,
        "time_scale" : 20,
        "stimuli": {
            "I1" : {"n" : 4, "sensor" : "light_sensor"},
            "I2" : {"n" : 2, "sensor" : "IR_receiver:msg"},
            "I3" : {"n" : 2, "sensor" : "IR_receiver:receiving_direction"},
            "I4" : {"n" : 1, "sensor" : "IR_receiver:state"},
            "I5" : {"n" : 4, "sensor" : "distance_sensor"}
        },
        "neuron_model" : "rate_model",
        "synapse_model" : "static_synapse",
        "ensembles": {
            "OUT_COMM" : {"n" : 1, "params" : {"tau": 0.5}},
            "OUT_COMM_STATE" : {"n" : 1, "params" : {"tau": 0.5}},
            "OUT_MOT" : {"n" : 2, "params" : {"activation" : "tanh"}}
        },
        "outputs" : {
            "outA" : {"ensemble" : "OUT_MOT", "actuator" : "joint_velocity_actuator", "enc": "real"},
            "outB" : {"ensemble" : "OUT_COMM", "actuator" : "IR_transmitter", "enc": "real"},
            "outC" : {"ensemble" : "OUT_COMM_STATE", "actuator" : "IR_transmitter:state", "enc": "real"}
        },
        "synapses" :  {
            "I1-OUT_COMM" : {"pre":"I1","post":"OUT_COMM", "trainable":true, "p":1.0},
            "I2-OUT_COMM" : {"pre":"I2","post":"OUT_COMM", "trainable":true, "p":1.0},
            "I3-OUT_COMM" : {"pre":"I3","post":"OUT_COMM", "trainable":true, "p":1.0},
            "I4-OUT_COMM" : {"pre":"I4","post":"OUT_COMM", "trainable":true, "p":1.0},
            "I5-OUT_COMM" : {"pre":"I5","post":"OUT_COMM", "trainable":true, "p":1.0},

            "I1-ST" : {"pre":"I1","post":"OUT_COMM_STATE", "trainable":true, "p":1.0},
            "I2-ST" : {"pre":"I2","post":"OUT_COMM_STATE", "trainable":true, "p":1.0},
            "I3-ST" : {"pre":"I3","post":"OUT_COMM_STATE", "trainable":true, "p":1.0},
            "I4-ST" : {"pre":"I4","post":"OUT_COMM_STATE", "trainable":true, "p":1.0},
            "I5-ST" : {"pre":"I5","post":"OUT_COMM_STATE", "trainable":true, "p":1.0},

            "I1-MOT" : {"pre":"I1","post":"OUT_MOT", "trainable":true, "p":1.0},
            "I2-MOT" : {"pre":"I2","post":"OUT_MOT", "trainable":true, "p":1.0},
            "I3-MOT" : {"pre":"I3","post":"OUT_MOT", "trainable":true, "p":1.0},
            "I4-MOT" : {"pre":"I4","post":"OUT_MOT", "trainable":true, "p":1.0},
            "I5-MOT" : {"pre":"I5","post":"OUT_MOT", "trainable":true, "p":1.0}
        },
        "decoding" : {
            "outA" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}},
            "outB" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}},
            "outC" : {"scheme" : "ThresholdDecoding", "params" : {"is_cat" : true}}   
        } 
    },
    "algorithm" : {
        "name" : "NEAT",
        "evolvable_object" : "robotA",
        "population_size" : 50,
        "generations" : 2000,
        "evaluation_steps" : 30,
        "num_evaluations" : 1,
        "fitness_function" : "goto_light",
        "populations" : {
            "p1" : {
                "objects" : ["synapses:weights:all", "neurons:bias:all",  "neurons:tau:all"],
                "max_vals" : [3,  1.5, 1.25],
                "min_vals" : [-3, -1.5, -0.8],
                "params" : {
                    "encoding" : "real",
                    "p_weight_mut" : 0.6,
                    "p_node_mut" : 0.15,
                    "p_conn_mut" : 0.2,
                    "compatib_thresh" : 3,
                    "c1" : 0.1,
                    "c2" : 0.1, 
                    "c3" : 1
                }
            }          
        }
    },
    "world":{
        "engine" : "3D",
        "world_delay" : 1,
        "render_connections":true,
        "height":15,
        "width": 15,
        "objects" : {
            "robotA" : {
                "type" : "robot",
                "num_instances" : 2,
                "controller" : "neural_controller",
                "sensors" : {
                    "light_sensor" : {"n_sectors" : 4, "range" : 20},
                    "IR_receiver" : {"n_sectors" : 4, "range" : 2, "msg_length" : 2, "selection_scheme" : "random"},
                    "distance_sensor" : {"n_sectors" : 4, "range" : 2}
                },
                "actuators" : {
                    "joint_velocity_actuator" : {"joint_ids" : [0, 1], "max_velocity" : 15},
                    "IR_transmitter" : {"quantize": true, "range" : 2, "msg_length":2}
                },
                "initializers" : {
                    "positions" : {"name" : "random_graph", "params" : {"max_rad": 3, "initial_pos" : [0, 0]}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low":0, "high" : 6.28, "size" : 1}}
                },
                "params" : {"trainable" : true}
            },
            "light_red" : {
                "type" : "light_source",
                "num_instances": 1,
                "controller" : "light_orbit_controller",
                "initializers" : {
                    "positions" : {"name" : "random_uniform", "params" : {"low":-1, "high" : 1, "size" : 2}}
                },
                "params" : {"range" : 20, "color" : "red"}
            }
        }
    }
}
