{
    "checkpoint_file" : "chk_border_SNES_final",
    "num_processes" : 1,
    "render" : false,
    "topology" : {
        "dt" : 0.1,
        "time_scale" : 20,
        "stimuli": {
            "W1" : {"n" : 2, "sensor" : "wireless_receiver:msg"},
            "W3" : {"n" : 1, "sensor" : "wireless_receiver:state"},
            "W4" : {"n" : 2, "sensor" : "wireless_receiver:receiving_direction"}
        },
        "encoding" : {
            "W1" :{"scheme" : "IdentityEncoding", "receptive_field" : {}},
            "W3" :{"scheme" : "IdentityEncoding", "receptive_field" : {}},
            "W4" :{"scheme" : "IdentityEncoding", "receptive_field" : {}}
        },
        "neuron_model" : "rate_model",
        "synapse_model" : "static_synapse",
        "ensembles": {
            "C" : {"n" : 10, "params" : {"gain" : 1.0}},
            "OUT_COMM" : {"n" : 2, "params" : {"gain" : 2.0}},
            "OUT_COMM_STATE" : {"n" : 1, "params" : {"gain" : 2.0}},
            "OUT_LED" : {"n" : 1, "params" : {"gain" : 2.0}}
        },
        "outputs" : {
            "outA" : {"ensemble" : "OUT_COMM", "actuator" : "wireless_transmitter", "enc": "real"},
            "outC" : {"ensemble" : "OUT_COMM_STATE", "actuator" : "wireless_transmitter:state", "enc": "cat"},
            "outB" : {"ensemble" : "OUT_LED", "actuator" : "led_actuator", "enc": "cat"}
        },
        "synapses" :  {
            "W1-c" : {"pre":"W1","post":"C", "trainable":true, "p":1.0},
            "W3-c" : {"pre":"W3","post":"C", "trainable":true, "p":1.0},
            "W4-c" : {"pre":"W4","post":"C", "trainable":true, "p":1.0},
        
            "c-c" : {"pre":"C","post":"C", "trainable":true, "p":1.0},

            "fast-comm" : {"pre":"C","post":"OUT_COMM", "trainable":true, "p":1.0},
            "fast-mot" : {"pre":"C","post":"OUT_LED", "trainable":true, "p":1.0},
            "c-st" : {"pre":"C","post":"OUT_COMM_STATE", "trainable":true, "p":1.0},
            "comm-fast" : {"pre":"OUT_COMM","post":"C", "trainable":true, "p":1.0},
            "mot-fast" : {"pre":"OUT_LED","post":"C", "trainable":true, "p":1.0},
            "st-c" : {"pre":"OUT_COMM_STATE","post":"C", "trainable":true, "p":1.0},
            "comm-comm" : {"pre":"OUT_COMM","post":"OUT_COMM", "trainable":true, "p":1.0},
            "led-comm" : {"pre":"OUT_LED","post":"OUT_COMM", "trainable":true, "p":1.0},
            "st-comm" : {"pre":"OUT_COMM_STATE","post":"OUT_COMM", "trainable":true, "p":1.0}
        },
        "decoding" : {
            "outA" : {"scheme" : "IdentityDecoding", "params" : {"is_cat" : false}},
            "outC" : {"scheme" : "ThresholdDecoding", "params" : {"is_cat" : true}},
            "outB" : {"scheme" : "ThresholdDecoding", "params" : {"is_cat" : true, "stochastic":false}}
        } 
    },
    "algorithm" : {
        "name" : "SNES",
        "evolvable_object" : "robotA",
        "population_size" : 40,
        "generations" : 5000,
        "evaluation_steps" : 200,
        "num_evaluations" : 1,
        "fitness_function" : "identify_borderline",
        "populations" : {
            "p4" : {
                "objects" : ["synapses:weights:all", "neurons:bias:all",  "neurons:tau:all"],
                "max_vals" : [3,  1.5, 0.75],
                "min_vals" : [-3, -1.5, -1],
                "params" : {"encoding" : "real"}
            }          
        }
    },
    "world":{
        "world_delay" : 30,
        "render_connections":false,
        "height":1000,
        "width": 1000,
        "objects" : {
            "robotA" : {
                "type" : "robot",
                "num_instances" : 30,
                "controller" : "neural_controller",
                "sensors" : {"wireless_receiver" : {"n_sectors" : 4, "range" : 100, "msg_length" : 2}},
                "actuators" : {"led_actuator" : {}, "wireless_transmitter" : {"quantize": true, "range" : 100, "msg_length":2}},
                "initializers" : {
                    "positions" : {"name" : "random_graph", "params" : {"max_rad":100, "initial_pos" : [500, 500]}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low":0, "high" : 3.1415, "size" : 1}}
                },
                "params" : {"trainable" : true}
            }
        }
    }
}
