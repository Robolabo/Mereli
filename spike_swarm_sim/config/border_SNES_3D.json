{
    "checkpoint_file" : "chk_border_SNES_3D",
    "topology" : {
        "dt" : 0.1,
        "time_scale" : 20,
        "stimuli": {
            "I1" : {"n" : 8, "sensor" : "distance_sensor3D"}
        },
        "neuron_model" : "rate_model",
        "synapse_model" : "static_synapse",
        "ensembles": {
            "H1" : {"n" : 10, "params" : {}},
            "OUT_MOT" : {"n" : 1, "params" : {}}
        },
        "outputs" : {
            "outA" : {"ensemble" : "OUT_MOT", "actuator" : "led_actuator_3D", "enc": "cat"}
        },
        "synapses" :  {
            "I1-H1" : {"pre":"I1","post":"H1", "trainable":true, "p":1.0},
            "H1-H1" : {"pre":"H1","post":"H1", "trainable":true, "p":1.0},
            "H1-MOT" : {"pre":"H1","post":"OUT_MOT", "trainable":true, "p":1.0},
            "MOT-H1" : {"pre":"OUT_MOT","post":"H1", "trainable":true, "p":1.0}
        },
        "decoding" : {
            "outA" : {"scheme" : "ThresholdDecoding", "params" : {"is_cat" : true}}
        } 
    },
    "algorithm" : {
        "name" : "SNES",
        "evolvable_object" : "robotA",
        "population_size" : 50,
        "generations" : 1000,
        "evaluation_steps" : 1300,
        "num_evaluations" : 1,
        "fitness_function" : "identify_borderline",
        "populations" : {
            "p1" : {
                "objects" : ["synapses:weights:all", "neurons:bias:all",  "neurons:tau:all", "neurons:gain:all"],
                "max_vals" : [3,  1.5, 0.75, 5],
                "min_vals" : [-3, -1.5, -1, 0.05],
                "params" : {"encoding" : "real"}
            }          
        }
    },
    "world":{
        "engine" : "3D",
        "world_delay" : 1,
        "render_connections":true,
        "height":1000,
        "width": 1000,
        "objects" : {
            "robotA" : {
                "type" : "robot",
                "num_instances" : 2,
                "controller" : "neural_controller",
                "sensors" : {"distance_sensor3D" : {"n_sectors" : 8, "range" : 0.9}},
                "actuators" : {"led_actuator_3D" : {"color_on" : "yellow", "color_off" : "white"}},
                "initializers" : {
                    "positions" : {"name" : "random_graph", "params" : {"max_rad":100, "initial_pos" : [500, 500]}},
                    "orientations" : {"name" : "random_uniform",  "params" : {"low":0, "high" : 6.28, "size" : 1}}
                },
                "perturbations" : {},
                "params" : {"trainable" : true}
            }
        }
    }
}
