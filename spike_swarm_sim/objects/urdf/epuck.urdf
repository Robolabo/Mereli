<?xml version="1.0"?>
<robot name="epuck">
    <link name="base_link">
        <visual>
            <geometry>
                <cylinder length="0.1" radius="0.1"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0"/>
            <material name="light_grey">
                <color rgba="0.8 0.8 0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.1" radius="0.1"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0"/>
        </collision>
        <inertial>
            <mass value="2"/>
            <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
        </inertial>
    </link>

     <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder length="0.015" radius="0.05"/>
            </geometry>
            <origin xyz="0 0 0"/>
            <material name="black">
                <color rgba="0.2 0.0 0.0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.015" radius="0.05"/>
            </geometry>
            <origin xyz="0 0 0"/>
        </collision>
        <inertial>
            <mass value="0.2"/>
            <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
        </inertial>
    </link>

    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder length="0.015" radius="0.05"/>
            </geometry>
            <origin xyz="0 0 0"/>
            <material name="black">
                <color rgba="0.0 0.0 0.0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.015" radius="0.05"/>
            </geometry>
            <origin xyz="0 0 0"/>
        </collision>
        <inertial>
            <mass value="0.2"/>
            <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
        </inertial>
    </link>

    <joint name="base_to_right_wheel" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
      	<axis xyz="0 0 1"/>
        <origin xyz="0.0 -0.109 -0.01" rpy="1.57075 0 0"/>
    </joint>

    <joint name="base_to_left_wheel" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
       	<axis xyz="0 0 1"/>
        <origin xyz="0 0.109 -0.01" rpy="1.57075 0 0"/>
    </joint>

    <link name="aux_wheel">
        <visual>
          	<origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.01"/>
            </geometry>
            <material name="red">
                <color rgba="1 0.0 0.0 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
               <sphere radius="0.01"/>
            </geometry>
           	<origin xyz="0 0 0"/>
        </collision>
        <inertial>
            <mass value="0.1"/>
            <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
        </inertial>
    </link>
    <joint name="base_to_aux_wheel" type="fixed">
        <parent link="base_link"/>
        <child link="aux_wheel"/>
        <origin xyz="0.08 0.0 -0.05" rpy="0 0 0"/>
    </joint>
        <link name="aux_wheel2">
        <visual>
          	<origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="0.01"/>
            </geometry>
            <material name="red">
                <color rgba="1 0.0 0.0 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
               <sphere radius="0.01"/>
            </geometry>
           	<origin xyz="0 0 0"/>
        </collision>
        <inertial>
            <mass value="0.1"/>
            <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
        </inertial>
    </link>
    <joint name="base_to_aux_wheel2" type="fixed">
        <parent link="base_link"/>
        <child link="aux_wheel2"/>
        <origin xyz="-0.08 0.0 -0.05" rpy="0 0 0"/>
    </joint>

    <link name="LED">
        <visual>
          	<origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="epuck_led_holder.obj" scale="1 1 1"/>
            </geometry>
            <material name="red">
                <color rgba="1 0.0 0.0 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
               <mesh filename="epuck_led_holder.obj" scale="1 1 1"/>
            </geometry>
           	<origin xyz="0 0 0"/>
        </collision>
        <inertial>
            <mass value="0.1"/>
            <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
        </inertial>
    </link>
    <joint name="base_to_LED" type="fixed">
        <parent link="base_link"/>
        <child link="LED"/>
        <origin xyz="0 0.0 0.027" rpy="1.57075 0 0"/>
    </joint>

    

</robot>